@model IEnumerable<RealEstateApp.Application.Dtos.Property.PropertyDto>
@using RealEstateApp.Application.Dtos.Property
@{
    ViewData["Title"] = "Mis Propiedades Favoritas";
    var filters = ViewBag.Filters as PropertyFiltersDto ?? new PropertyFiltersDto();
    var totalProperties = Model.Count();
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/home-properties.css" />

<div class="home-page">
    <div class="home-container">
        <!-- Header -->
        <div class="home-header">
            <div class="header-info">
                <h1 class="header-title">Mis Propiedades Favoritas</h1>
                <p class="header-subtitle">
                    <span class="property-count">@totalProperties</span> propiedades favoritas
                </p>
            </div>
        </div>

        <!-- Filtros Globales -->
        <div class="filters-section">
            <form asp-action="MyProperties" asp-controller="ClientProperty" method="get" class="filters-form">
                @await Html.PartialAsync("_PropertyFilters", filters)
            </form>
        </div>

        @if (Model.Any())
        {
            <!-- Properties Grid -->
            <div class="properties-grid">
                @foreach (var property in Model.OrderByDescending(p => p.CreatedAt))
                {
                    <article class="property-card">
                        <div class="card-image">
                            <form asp-action="ToggleFavorite" asp-controller="ClientProperty" method="post" class="fav-form">
                                <input type="hidden" name="propertyId" value="@property.Id" />
                                <button type="submit"
                                        class="btn-favorite is-favorite"
                                        title="Remover de favoritos"
                                        onclick="return confirm('¿Estás seguro de que quieres eliminar esta propiedad de tus favoritos?')">
                                    <i class="fas fa-heart"></i>
                                </button>
                            </form>

                            <span class="badge-type">@(!string.IsNullOrWhiteSpace(property.PropertyType) ? property.PropertyType : "Propiedad")</span>
                            <span class="badge-sale">@(!string.IsNullOrWhiteSpace(property.SaleType) ? property.SaleType : "Venta")</span>

                            @if (!string.IsNullOrEmpty(property.MainImageUrl))
                            {
                                <img src="@property.MainImageUrl" alt="@property.Code" class="card-img" loading="lazy">
                            }
                            else
                            {
                                <div class="card-img-placeholder">
                                    <i class="fas fa-home"></i>
                                </div>
                            }
                        </div>

                        <div class="card-content">
                            <p class="card-code">Código: @property.Code</p>

                            <div class="card-price">
                                RD$@property.Price.ToString("N0") <span class="currency">DOP</span>
                            </div>

                            <div class="card-features">
                                <div class="feature">
                                    <i class="fas fa-bed"></i>
                                    <span>@property.Bedrooms Hab.</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-bath"></i>
                                    <span>@property.Bathrooms Baños</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-ruler-combined"></i>
                                    <span>@property.Size m²</span>
                                </div>
                            </div>

                            <a href="@Url.Action("Details", "PublicProperty", new { id = property.Id })" class="btn-view-details">
                                Ver detalles <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-heart"></i>
                </div>
                <h3 class="empty-title">No tienes propiedades favoritas</h3>
                <p class="empty-text">
                    @if (filters.Code != null || filters.PropertyTypeId != null || filters.MinPrice != null || filters.MaxPrice != null || filters.Bedrooms != null || filters.Bathrooms != null)
                    {
                        <text>No hay propiedades favoritas que coincidan con los filtros. Intenta ajustarlos.</text>
                    }
                    else
                    {
                        <text>Explora nuestras propiedades y marca tus favoritas haciendo clic en el corazón.</text>
                    }
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1.5rem;">
                    <a href="@Url.Action("Index", "Home")" class="btn-empty-action">
                        <i class="fas fa-search"></i> Buscar Propiedades
                    </a>
                    @if (filters.Code != null || filters.PropertyTypeId != null || filters.MinPrice != null || filters.MaxPrice != null || filters.Bedrooms != null || filters.Bathrooms != null)
                    {
                        <a href="@Url.Action("MyProperties", "ClientProperty")" class="btn-empty-action" style="background: var(--surface-sunken); color: var(--text-secondary);">
                            <i class="fas fa-redo"></i> Limpiar Filtros
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
