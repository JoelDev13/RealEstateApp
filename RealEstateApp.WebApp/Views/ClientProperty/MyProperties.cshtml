@model IEnumerable<RealEstateApp.Application.Dtos.Property.PropertyDto>
@{
    ViewData["Title"] = "Mis Propiedades";
}

@Html.AntiForgeryToken()

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="flex">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg min-h-screen">
            <div class="p-6 bg-gradient-to-r from-blue-600 to-indigo-600">
                <h3 class="text-white font-bold text-lg">Panel del Cliente</h3>
            </div>
            <nav class="mt-6">
                <a href="@Url.Action("Index", "Home")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-home w-5 mr-3"></i> Home
                </a>
                <a href="@Url.Action("MyProperties", "ClientProperty")" class="flex items-center px-6 py-3 bg-blue-50 text-blue-600 border-r-4 border-blue-600">
                    <i class="fas fa-heart w-5 mr-3"></i> Mis Propiedades
                </a>
                <a href="@Url.Action("Profile", "Account")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-user w-5 mr-3"></i> Mi perfil
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 mr-3"></i> Cerrar sesión
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 mb-2">Mis Propiedades Favoritas</h1>
                        <p class="text-gray-600">Bienvenido, @ViewBag.UserName</p>
                    </div>
                    <a href="@Url.Action("Index", "Home")" 
                       class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center">
                        <i class="fas fa-search mr-2"></i> Buscar más propiedades
                    </a>
                </div>
            </div>

            <!-- Properties Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var property in Model.OrderByDescending(p => p.CreatedAt))
                {
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                        <!-- Favorite Button (always active in favorites view) -->
                        <div class="absolute top-4 right-4 z-10">
                            <form asp-action="ToggleFavorite" asp-controller="ClientProperty" method="post" class="inline">
                                <input type="hidden" name="propertyId" value="@property.Id" />
                                <button type="submit" 
                                        class="bg-white rounded-full p-2 shadow-lg hover:shadow-xl transition-all"
                                        onclick="return confirm('¿Estás seguro de que quieres eliminar esta propiedad de tus favoritos?')">
                                    <i class="fas fa-heart text-xl text-red-500"></i>
                                </button>
                            </form>
                        </div>
                        
                        <!-- Property Image -->
                        <div class="relative h-48 bg-gradient-to-br from-blue-500 to-blue-600">
                            @if (!string.IsNullOrEmpty(property.MainImageUrl))
                            {
                                <img src="~/Images/Properties/@property.MainImageUrl" 
                                     alt="@property.Code" 
                                     class="w-full h-48 object-cover"
                                     onerror="this.outerHTML='<div class=\'w-full h-48 bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center\'><div class=\'text-white text-center\'><i class=\'fas fa-exclamation-triangle text-4xl mb-2 opacity-80\'></i><p class=\'text-sm font-medium\'>Error Imagen</p></div></div>'">
                            }
                            else
                            {
                                <div class="w-full h-48 flex items-center justify-center">
                                    <div class="text-white text-center">
                                        <i class="fas fa-home text-4xl mb-2 opacity-80"></i>
                                        <p class="text-sm font-medium">Sin Imagen</p>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <!-- Property Info -->
                        <div class="p-6">
                            <div class="mb-4">
                                <h3 class="text-lg font-bold text-gray-800">@property.Code</h3>
                                <p class="text-sm text-gray-600">@property.PropertyType</p>
                                <p class="text-sm text-gray-600">@property.SaleType</p>
                            </div>
                            
                            <div class="mb-4">
                                <p class="text-2xl font-bold text-blue-600">
                                    @property.Price.ToString("C0", new System.Globalization.CultureInfo("es-DO")) DOP
                                </p>
                            </div>
                            
                            <div class="mb-4 text-sm text-gray-600">
                                <div class="flex items-center mb-1">
                                    <i class="fas fa-bed mr-2"></i> @property.Bedrooms Habitaciones
                                </div>
                                <div class="flex items-center mb-1">
                                    <i class="fas fa-bath mr-2"></i> @property.Bathrooms Baños
                                </div>
                                <div class="flex items-center">
                                    <i class="fas fa-ruler-combined mr-2"></i> @property.Size m²
                                </div>
                            </div>
                            
                            <div class="flex space-x-2">
                                <a href="@Url.Action("Details", "Property", new { id = property.Id })" 
                                   class="flex-1 bg-blue-600 text-white text-center py-2 rounded-lg hover:bg-blue-700 transition-colors">
                                    Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-12">
                    <i class="fas fa-heart text-6xl text-gray-300 mb-4"></i>
                    <h3 class="text-xl font-semibold text-gray-600 mb-2">No tienes propiedades favoritas</h3>
                    <p class="text-gray-500 mb-6">Explora nuestras propiedades y marca tus favoritas</p>
                    <a href="@Url.Action("Index", "Home")" 
                       class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-search mr-2"></i> Buscar Propiedades
                    </a>
                </div>
            }
        </div>
    </div>
</div>

