@model RealEstateApp.WebApp.Models.Agents.AgentPropertiesViewModel
@using RealEstateApp.Application.Dtos.Property

@{
    ViewData["Title"] = "Mis Propiedades";
    var filters = ViewBag.Filters as PropertyFiltersDto ?? new PropertyFiltersDto();
}

<link rel="stylesheet" href="~/css/home-properties.css" />

<div class="home-page">
    <div class="home-container">

        <!-- Page Header -->
        <div class="home-header">
            <div>
                <h1 class="header-title">Mis Propiedades</h1>
                <p class="header-subtitle">
                    <span class="property-count">@Model.Properties.Count</span> propiedades encontradas
                </p>
            </div>
            <a href="@Url.Action("Create", "Property")" class="btn btn-primary btn-lg">
                <i class="fas fa-plus"></i>
                Nueva Propiedad
            </a>
        </div>

        <!-- Filters Section -->
        <div class="filters-section">
            <form asp-action="Properties" asp-controller="Agent" method="get" class="filters-form">
                @await Html.PartialAsync("_PropertyFilters", filters)
            </form>
        </div>

        <!-- Properties Grid -->
        @if (!Model.Properties.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="empty-title">No se encontraron propiedades</h3>
                <p class="empty-text">
                    @if (string.IsNullOrWhiteSpace(filters.Code) &&
                                    !filters.PropertyTypeId.HasValue &&
                                    !filters.MinPrice.HasValue &&
                                    !filters.MaxPrice.HasValue &&
                                    !filters.Bedrooms.HasValue &&
                                    !filters.Bathrooms.HasValue)
                    {
                        <text>Comienza creando tu primera propiedad para gestionar tu portafolio inmobiliario</text>
                    }
                    else
                    {
                        <text>Intenta ajustar los filtros de búsqueda</text>
                    }
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1.5rem;">
                    @if (!string.IsNullOrWhiteSpace(filters.Code) ||
                                    filters.PropertyTypeId.HasValue ||
                                    filters.MinPrice.HasValue ||
                                    filters.MaxPrice.HasValue ||
                                    filters.Bedrooms.HasValue ||
                                    filters.Bathrooms.HasValue)
                    {
                        <a href="@Url.Action("Properties", "Agent")" class="btn-empty-action">
                            <i class="fas fa-redo"></i> Limpiar filtros
                        </a>
                    }
                    <a href="@Url.Action("Create", "Property")" class="btn-empty-action" style="background: linear-gradient(135deg, var(--luxury-gold-dark) 0%, var(--luxury-gold) 100%);">
                        <i class="fas fa-plus"></i> Crear Propiedad
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="properties-grid">
                @foreach (var property in Model.Properties)
                {
                    <article class="property-card">
                        <div class="card-image">
                            <span class="badge-type">@property.PropertyType</span>
                            <span class="badge-sale">@property.SaleType</span>

                            @if (string.IsNullOrEmpty(property.MainImageUrl))
                            {
                                <div class="card-img-placeholder">
                                    <i class="fas fa-home"></i>
                                </div>
                            }
                            else
                            {
                                <img src="@property.MainImageUrl"
                                     alt="@property.Code"
                                     class="card-img"
                                     loading="lazy">
                            }
                        </div>

                        <div class="card-content">
                            <p class="card-code">Código: @property.Code</p>

                            <div class="card-price">
                                RD$@property.Price.ToString("N0") <span class="currency">DOP</span>
                            </div>

                            <div class="card-features">
                                <div class="feature">
                                    <i class="fas fa-bed"></i>
                                    <span>@property.Bedrooms Hab.</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-bath"></i>
                                    <span>@property.Bathrooms Baños</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-ruler-combined"></i>
                                    <span>@property.Size.ToString("N2") m²</span>
                                </div>
                            </div>

                            <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
                                <a href="@Url.Action("Details", "Property", new { id = property.Id })"
                                   class="btn-view-details" style="flex: 1; font-size: 0.8rem; padding: 0.625rem;">
                                    <i class="fas fa-eye"></i> Ver
                                </a>
                                <a href="@Url.Action("Edit", "Property", new { id = property.Id })"
                                   class="btn-view-details" style="flex: 1; font-size: 0.8rem; padding: 0.625rem; background: var(--luxury-gold); color: var(--luxury-black);">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <button type="button"
                                        onclick="confirmDelete('@property.Id', '@property.Code')"
                                        class="btn-view-details"
                                        style="flex: 1; font-size: 0.8rem; padding: 0.625rem; background: #dc2626; color: white;">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div id="deleteModal" class="modal-overlay" onclick="if(event.target === this) closeModal()">
    <div class="modal-container" onclick="event.stopPropagation()">
        <div class="modal-header" style="background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);">
            <h3 class="modal-title" style="color: white;">
                <i class="fas fa-exclamation-triangle"></i>
                Confirmar Eliminación
            </h3>
            <button type="button" class="modal-close" onclick="closeModal()" style="background: rgba(255, 255, 255, 0.2);">
                <i class="fas fa-times" style="color: white;"></i>
            </button>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.9375rem; color: var(--text-secondary); margin-bottom: 1rem;">
                ¿Está seguro que desea eliminar la propiedad?
            </p>
            <p style="font-weight: 600; color: var(--text-primary); font-size: 1.125rem;">
                <strong id="propertyCode"></strong>
            </p>
            <p style="font-size: 0.875rem; color: var(--status-error); margin-top: 1rem;">
                <i class="fas fa-exclamation-circle"></i>
                Esta acción no se puede deshacer
            </p>
        </div>
        <div class="modal-footer">
            <button type="button" onclick="closeModal()" class="btn-modal-cancel">
                <i class="fas fa-times"></i>
                Cancelar
            </button>
            <form id="deleteForm" method="post" style="display: inline; flex: 1;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-submit" style="background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);">
                    <i class="fas fa-trash"></i>
                    Eliminar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(propertyId, propertyCode) {
            const modal = document.getElementById('deleteModal');
            document.getElementById('propertyCode').textContent = propertyCode;
            document.getElementById('deleteForm').action = '/Property/Delete/' + propertyId;

            modal.classList.add('active');
        }

        function closeModal() {
            const modal = document.getElementById('deleteModal');
            modal.classList.remove('active');
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        function clearFiltersPartial() {
            window.location.href = '/Agent/Properties';
        }
    </script>
}
