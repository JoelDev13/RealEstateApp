@model RealEstateApp.WebApp.Models.Agents.AgentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/home-properties.css" />
<link rel="stylesheet" href="~/css/agent-dashboard.css" />

<div class="agent-dashboard">
    <div class="dashboard-wrapper">

        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1 class="page-title">Mis Propiedades</h1>
                <p class="page-description">Gestiona y monitorea tu portafolio inmobiliario</p>
            </div>
        </div>

        <!-- Stats Cards Row -->
        <div class="stats-row">
            <div class="stat-card gold">
                <div class="stat-icon-bg">
                    <i class="fas fa-building"></i>
                </div>
                <div class="stat-content">
                    <h3 class="stat-number">@Model.Properties.Count</h3>
                    <p class="stat-label">Total Propiedades</p>
                </div>
            </div>

            <div class="stat-card green">
                <div class="stat-icon-bg">
                    <i class="fas fa-home"></i>
                </div>
                <div class="stat-content">
                    <h3 class="stat-number">@Model.Properties.Count(p => !p.IsSold)</h3>
                    <p class="stat-label">Disponibles</p>
                </div>
            </div>

            <div class="stat-card blue">
                <div class="stat-icon-bg">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <h3 class="stat-number">@Model.Properties.Count(p => p.IsSold)</h3>
                    <p class="stat-label">Vendidas</p>
                </div>
            </div>
        </div>

        @if (!Model.Properties.Any())
        {
            <!-- Empty State -->
            <div class="empty-state-dashboard">
                <div class="empty-illustration">
                    <i class="fas fa-building"></i>
                </div>
                <h3 class="empty-title">No tienes propiedades registradas</h3>
                <p class="empty-description">Comienza a construir tu portafolio inmobiliario agregando tu primera propiedad</p>
                <a href="@Url.Action("Create", "Property")" class="btn-get-started">
                    <i class="fas fa-plus-circle"></i>
                    Crear Mi Primera Propiedad
                </a>
            </div>
        }
        else
        {
            <!-- Properties Section -->
            <div class="properties-section">
                <div class="section-header">
                    <h2 class="section-title">Todas las Propiedades</h2>
                    <span class="properties-count">@Model.Properties.Count propiedades</span>
                </div>

                <!-- Properties Grid -->
                <div class="properties-grid">
                    @foreach (var property in Model.Properties.OrderByDescending(p => p.CreatedAt))
                    {
                        <article class="property-card @(property.IsSold ? "is-sold" : "")">
                            <div class="card-image">
                                @if (property.IsSold)
                                {
                                    <div class="sold-badge">
                                        <i class="fas fa-check-circle"></i>
                                        <span>VENDIDA</span>
                                    </div>
                                }

                                <span class="badge-type">@(!string.IsNullOrWhiteSpace(property.PropertyType) ? property.PropertyType : "Propiedad")</span>
                                <span class="badge-sale">@(!string.IsNullOrWhiteSpace(property.SaleType) ? property.SaleType : "Venta")</span>

                                @if (!string.IsNullOrEmpty(property.MainImageUrl))
                                {
                                    <img src="@property.MainImageUrl" alt="@property.Code" class="card-img" loading="lazy">
                                }
                                else
                                {
                                    <div class="card-img-placeholder">
                                        <i class="fas fa-home"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-content">
                                <p class="card-code">Código: @property.Code</p>

                                <div class="card-price">
                                    RD$@property.Price.ToString("N0") <span class="currency">DOP</span>
                                </div>

                                <div class="card-features">
                                    <div class="feature">
                                        <i class="fas fa-bed"></i>
                                        <span>@property.Bedrooms Hab. </span>
                                    </div>
                                    <div class="feature">
                                        <i class="fas fa-bath"></i>
                                        <span>@property.Bathrooms Baños</span>
                                    </div>
                                    <div class="feature">
                                        <i class="fas fa-ruler-combined"></i>
                                        <span>@property.Size m²</span>
                                    </div>
                                </div>

                                <div class="card-actions">
                                    <a href="@Url.Action("Details", "Property", new { id = property.Id })" class="btn-view">
                                        <i class="fas fa-eye"></i> Ver detalles
                                    </a>

                                    @if (!property.IsSold)
                                    {
                                        <a href="@Url.Action("Edit", "Property", new { id = property.Id })" class="btn-edit" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </div>
</div>
