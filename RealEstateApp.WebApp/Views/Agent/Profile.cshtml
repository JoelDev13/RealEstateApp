@model RealEstateApp.WebApp.Models.Agents.AgentProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<link rel="stylesheet" href="~/css/home-properties.css" />
<link rel="stylesheet" href="~/css/property-form.css" />

<div class="home-page">
    <div class="home-container" style="max-width: 1000px;">
        <div style="margin-bottom: 1.5rem;">
            <a href="@Url.Action("Dashboard", "Agent")" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Volver al Dashboard
            </a>
        </div>

        <div class="home-header" style="margin-bottom: 2rem;">
            <div>
                <h1 class="header-title">Mi Perfil</h1>
                <p class="header-subtitle">Actualiza tu información personal</p>
            </div>
        </div>

        <div class="form-card" style="max-width: 100%;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-triangle"></i>
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-user"></i>
                        Información Personal
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="FirstName" class="form-label">Nombre *</label>
                            <div class="input-with-icon">
                                <i class="fas fa-user"></i>
                                <input asp-for="FirstName" class="form-input" placeholder="Juan" required />
                            </div>
                            <span asp-validation-for="FirstName" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName" class="form-label">Apellido *</label>
                            <div class="input-with-icon">
                                <i class="fas fa-user"></i>
                                <input asp-for="LastName" class="form-input" placeholder="Pérez" required />
                            </div>
                            <span asp-validation-for="LastName" class="form-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-phone"></i>
                        Información de Contacto
                    </h3>
                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="form-label">Teléfono *</label>
                        <div class="input-with-icon">
                            <i class="fas fa-phone"></i>
                            <input asp-for="PhoneNumber" class="form-input" type="tel" placeholder="(809) 555-1234" required />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="form-error"></span>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-camera"></i>
                        Foto de Perfil
                    </h3>
                    <div class="form-group">
                        <label asp-for="ProfileImage" class="form-label">Foto de usuario (Opcional)</label>
                        <div class="file-input-wrapper">
                            <input asp-for="ProfileImage" class="file-input" type="file" accept="image/*" id="profileImageUpload" />
                            <label for="profileImageUpload" class="file-input-label">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Seleccionar foto de perfil</span>
                                <small>JPG, PNG (Máx. 2MB)</small>
                            </label>
                        </div>
                        <span asp-validation-for="ProfileImage" class="form-error"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Dashboard", "Agent")" class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('profileImageUpload')?.addEventListener('change', function (e) {
            const fileLabel = this.nextElementSibling.querySelector('span');
            const fileName = this.files[0]?.name;
            if (fileName) {
                fileLabel.textContent = fileName;
            } else {
                fileLabel.textContent = 'Seleccionar foto de perfil';
            }
        });
    </script>
}
