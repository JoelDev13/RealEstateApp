@model RealEstateApp.Domain.Entities.Property
@{
    ViewData["Title"] = $"Detalles - {Model.Code}";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
    <div class="container mx-auto px-4">
        <!-- Breadcrumb -->
        <nav class="mb-6">
            <ol class="flex items-center space-x-2 text-sm text-gray-600">
                <li><a href="@Url.Action("Index", "Home")" class="hover:text-blue-600">Inicio</a></li>
                <li><i class="fas fa-chevron-right text-xs"></i></li>
                <li class="text-gray-800 font-semibold">@Model.Code</li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Columna Principal -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Galeria de Imagenes -->
                <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        <div class="relative">
                            <div id="propertyCarousel" class="relative h-96">
                                @foreach (var image in Model.Images)
                                {
                                    <div class="carousel-item absolute inset-0 opacity-0 transition-opacity duration-500">
                                        <img src="~/Images/Properties/@image.Url"
                                             alt="@Model.Code"
                                             class="w-full h-96 object-cover">
                                    </div>
                                }
                            </div>

                            @if (Model.Images.Count > 1)
                            {
                                <button onclick="prevSlide()" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white p-3 rounded-full shadow-lg transition-all">
                                    <i class="fas fa-chevron-left text-gray-800"></i>
                                </button>
                                <button onclick="nextSlide()" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white p-3 rounded-full shadow-lg transition-all">
                                    <i class="fas fa-chevron-right text-gray-800"></i>
                                </button>

                                <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2">
                                    @for (int i = 0; i < Model.Images.Count; i++)
                                    {
                                        <button onclick="goToSlide(@i)" class="slide-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all"></button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="h-96 bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center">
                            <div class="text-white text-center">
                                <i class="fas fa-home text-6xl mb-4 opacity-80"></i>
                                <p class="text-xl font-medium">Sin Imágenes</p>
                            </div>
                        </div>
                    }
                </div>

                <!-- Informacion Principal -->
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <div class="flex items-start justify-between mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-gray-800 mb-2">@Model.Code</h1>
                            <div class="flex items-center space-x-4 text-gray-600">
                                <span class="flex items-center">
                                    <i class="fas fa-tag mr-2 text-blue-600"></i>
                                    @Model.PropertyType?.Name
                                </span>
                                <span class="flex items-center">
                                    <i class="fas fa-handshake mr-2 text-blue-600"></i>
                                    @Model.SaleType?.Name
                                </span>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-4xl font-bold text-blue-600">
                                @Model.Price.ToString("C0", new System.Globalization.CultureInfo("es-DO"))
                            </p>
                            <p class="text-sm text-gray-500">DOP</p>
                        </div>
                    </div>

                    <!-- Caracteristicas -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 p-6 bg-gray-50 rounded-lg">
                        <div class="text-center">
                            <i class="fas fa-bed text-2xl text-blue-600 mb-2"></i>
                            <p class="text-2xl font-bold text-gray-800">@Model.Bedrooms</p>
                            <p class="text-sm text-gray-600">Habitaciones</p>
                        </div>
                        <div class="text-center">
                            <i class="fas fa-bath text-2xl text-blue-600 mb-2"></i>
                            <p class="text-2xl font-bold text-gray-800">@Model.Bathrooms</p>
                            <p class="text-sm text-gray-600">Baños</p>
                        </div>
                        <div class="text-center">
                            <i class="fas fa-ruler-combined text-2xl text-blue-600 mb-2"></i>
                            <p class="text-2xl font-bold text-gray-800">@Model.Size</p>
                            <p class="text-sm text-gray-600">m²</p>
                        </div>
                        <div class="text-center">
                            <i class="fas fa-info-circle text-2xl text-blue-600 mb-2"></i>
                            <p class="text-sm font-bold text-gray-800">@Model.Status</p>
                            <p class="text-sm text-gray-600">Estado</p>
                        </div>
                    </div>

                    <!-- Descripcion -->
                    <div class="mb-6">
                        <h3 class="text-xl font-bold text-gray-800 mb-3">Descripción</h3>
                        <p class="text-gray-700 leading-relaxed">@Model.Description</p>
                    </div>

                    <!-- Mejoras -->
                    @if (Model.Improvements != null && Model.Improvements.Any())
                    {
                        <div>
                            <h3 class="text-xl font-bold text-gray-800 mb-3">Mejoras</h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                @foreach (var improvement in Model.Improvements)
                                {
                                    <div class="flex items-center space-x-2 text-gray-700">
                                        <i class="fas fa-check-circle text-green-500"></i>
                                        <span>@improvement.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Columna Lateral -->
            <div class="space-y-6">
                <!-- Informacion del Agente -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Agente de la Propiedad</h3>
                    <div class="text-center mb-4">
                        <div class="w-24 h-24 mx-auto mb-3 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center">
                            <i class="fas fa-user-tie text-4xl text-white"></i>
                        </div>
                        <p class="text-lg font-semibold text-gray-800">Agente Responsable</p>
                        <p class="text-sm text-gray-600">@Model.AgentId</p>
                    </div>
                </div>

                <!-- Acciones -->
                <div class="bg-white rounded-xl shadow-lg p-6 space-y-3">
                    @if (ViewBag.IsClient == true)
                    {
                        <!-- Boton de Chat (Solo Clientes) -->
                        <a href="@Url.Action("PropertyChat", "Chat", new { propertyId = Model.Id })"
                           class="block w-full px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-center rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all transform hover:scale-105 shadow-lg">
                            <i class="fas fa-comments mr-2"></i> Chatear con el Agente
                        </a>

                        <!-- Boton de Favoritos -->
                        <form asp-action="ToggleFavorite" asp-controller="PublicProperty" method="post">
                            <input type="hidden" name="propertyId" value="@Model.Id" />
                            <button type="submit"
                                    class="w-full px-6 py-3 @(ViewBag.IsFavorite ? "bg-red-500 hover:bg-red-600" : "bg-gray-200 hover:bg-gray-300 text-gray-800") text-white rounded-lg transition-all">
                                <i class="fas fa-heart mr-2"></i>
                                @(ViewBag.IsFavorite ? "Quitar de Favoritos" : "Agregar a Favoritos")
                            </button>
                        </form>
                    }
                    else if (ViewBag.IsAuthenticated == false)
                    {
                        <!-- Mensaje para No Autenticados -->
                        <div class="text-center p-4 bg-blue-50 rounded-lg">
                            <i class="fas fa-info-circle text-blue-600 text-2xl mb-2"></i>
                            <p class="text-sm text-gray-700 mb-3">Inicia sesión para chatear con el agente y agregar a favoritos</p>
                            <a href="@Url.Action("Login", "Account")"
                               class="inline-block px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all">
                                Iniciar Sesión
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- Mensaje para Agentes -->
                        <div class="text-center p-4 bg-gray-50 rounded-lg">
                            <i class="fas fa-user-tie text-gray-400 text-2xl mb-2"></i>
                            <p class="text-sm text-gray-600">Los agentes no pueden chatear sobre propiedades</p>
                        </div>
                    }

                    <!-- Boton Volver -->
                    <a href="@Url.Action("Index", "Home")"
                       class="block w-full px-6 py-3 bg-gray-200 text-gray-800 text-center rounded-lg hover:bg-gray-300 transition-all">
                        <i class="fas fa-arrow-left mr-2"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-item');
        const dots = document.querySelectorAll('.slide-dot');

        function showSlide(index) {
            slides.forEach((slide, i) => {
                slide.classList.toggle('opacity-0', i !== index);
                slide.classList.toggle('opacity-100', i === index);
            });

            dots.forEach((dot, i) => {
                dot.classList.toggle('bg-white/50', i !== index);
                dot.classList.toggle('bg-white', i === index);
            });

            currentSlide = index;
        }

        function nextSlide() {
            const next = (currentSlide + 1) % slides.length;
            showSlide(next);
        }

        function prevSlide() {
            const prev = (currentSlide - 1 + slides.length) % slides.length;
            showSlide(prev);
        }

        function goToSlide(index) {
            showSlide(index);
        }

        if (slides.length > 0) {
            showSlide(0);
        }

        setInterval(nextSlide, 5000);
    </script>
}