@model RealEstateApp.Domain.Entities.Property

@{
    ViewData["Title"] = $"Detalles - {Model.Code}";
}

<link rel="stylesheet" href="~/css/PropertyDetails/property-details-base.css" />
<link rel="stylesheet" href="~/css/PropertyDetails/property-details-public.css" />

<div class="details-page">
    <div class="details-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <a href="@Url.Action("Index", "Home")">Inicio</a>
            <span class="breadcrumb-separator"><i class="fas fa-chevron-right"></i></span>
            <span class="breadcrumb-current">@Model.Code</span>
        </nav>

        <!-- Details Grid -->
        <div class="details-grid">

            <!-- Main Column (Left) -->
            <div class="main-column">

                <!-- Image Gallery -->
                <div class="gallery-section">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        <div class="carousel-container">
                            @foreach (var image in Model.Images)
                            {
                                <div class="carousel-item">
                                    <img src="@image.Url" alt="@Model.Code" loading="lazy" />
                                </div>
                            }

                            @if (Model.Images.Count > 1)
                            {
                                <button class="carousel-btn carousel-btn-prev" onclick="prevSlide()" aria-label="Anterior">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button class="carousel-btn carousel-btn-next" onclick="nextSlide()" aria-label="Siguiente">
                                    <i class="fas fa-chevron-right"></i>
                                </button>

                                <div class="carousel-dots">
                                    @for (int i = 0; i < Model.Images.Count; i++)
                                    {
                                        <button class="carousel-dot" onclick="goToSlide(@i)" aria-label="Ir a imagen @(i + 1)"></button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="carousel-placeholder">
                            <i class="fas fa-home"></i>
                            <p>Sin Imágenes Disponibles</p>
                        </div>
                    }
                </div>

                <!-- Property Info Card -->
                <div class="info-card">
                    <div class="info-header">
                        <div class="info-title-section">
                            <h1>@Model.Code</h1>
                            <div class="info-tags">
                                <span class="info-tag">
                                    <i class="fas fa-tag"></i>
                                    @(Model.PropertyType?.Name ?? "Propiedad")
                                </span>
                                <span class="info-tag">
                                    <i class="fas fa-handshake"></i>
                                    @(Model.SaleType?.Name ?? "Venta")
                                </span>
                            </div>
                        </div>
                        <div class="info-price-section">
                            <div class="price-amount">RD$@Model.Price.ToString("N0")</div>
                            <div class="price-currency">DOP</div>
                        </div>
                    </div>

                    <!-- Features Grid -->
                    <div class="features-grid">
                        <div class="feature-item">
                            <i class="fas fa-bed"></i>
                            <div>
                                <div class="feature-value">@Model.Bedrooms</div>
                                <div class="feature-label">Habitaciones</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-bath"></i>
                            <div>
                                <div class="feature-value">@Model.Bathrooms</div>
                                <div class="feature-label">Baños</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-ruler-combined"></i>
                            <div>
                                <div class="feature-value">@Model.Size</div>
                                <div class="feature-label">m²</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-info-circle"></i>
                            <div>
                                <div class="feature-value" style="font-size: 0.875rem;">@Model.Status</div>
                                <div class="feature-label">Estado</div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="description-section">
                        <h3 class="section-title">Descripción</h3>
                        <p class="description-text">@Model.Description</p>
                    </div>

                    <!-- Improvements -->
                    @if (Model.Improvements != null && Model.Improvements.Any())
                    {
                        <div class="improvements-section">
                            <h3 class="section-title">Mejoras y Características</h3>
                            <div class="improvements-grid">
                                @foreach (var improvement in Model.Improvements)
                                {
                                    <div class="improvement-item">
                                        <div class="improvement-icon">
                                            <i class="fas fa-star"></i>
                                        </div>
                                        <span>@improvement.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>

            <!-- Sidebar Column (Right) -->
            <div class="sidebar-column">

                <!-- Agent Card -->
                <div class="agent-card-luxury">
                    <div class="agent-card-header">
                        <i class="fas fa-user-tie"></i>
                        <h3>Agente de la Propiedad</h3>
                    </div>
                    <div class="agent-card-body">
                        <div class="agent-avatar-container">
                            @if (!string.IsNullOrEmpty(ViewBag.AgentProfilePicture))
                            {
                                <img src="@ViewBag.AgentProfilePicture" alt="@ViewBag.AgentName" class="agent-avatar-image" />
                            }
                            else
                            {
                                <div class="agent-avatar-placeholder-luxury">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                        </div>
                        <h4 class="agent-name-luxury">@(ViewBag.AgentName ?? "Agente Inmobiliario")</h4>
                        <p class="agent-role-luxury">Agente Responsable</p>

                        <div class="agent-contact-luxury">
                            @if (!string.IsNullOrEmpty(ViewBag.AgentPhone))
                            {
                                <div class="contact-item-luxury">
                                    <div class="contact-icon">
                                        <i class="fas fa-phone"></i>
                                    </div>
                                    <a href="tel:@ViewBag.AgentPhone">@ViewBag.AgentPhone</a>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.AgentEmail))
                            {
                                <div class="contact-item-luxury">
                                    <div class="contact-icon">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                    <a href="mailto:@ViewBag.AgentEmail">@ViewBag.AgentEmail</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Actions Card -->
                <div class="actions-card-luxury">
                    @if (ViewBag.IsClient == true)
                    {
                        <!-- Chat Button -->
                        <a href="@Url.Action("PropertyChat", "Chat", new { propertyId = Model.Id })" class="btn-luxury-primary">
                            <i class="fas fa-comments"></i>
                            <span>Chatear con el Agente</span>
                        </a>

                        <!-- Offers Button -->
                        <a href="@Url.Action("PropertyOffers", "Offer", new { propertyId = Model.Id })" class="btn-luxury-secondary">
                            <i class="fas fa-hand-holding-usd"></i>
                            <span>Ver Mis Ofertas</span>
                        </a>

                        <!-- Favorite Button -->
                        <form asp-action="ToggleFavorite" asp-controller="PublicProperty" method="post">
                            <input type="hidden" name="propertyId" value="@Model.Id" />
                            <button type="submit" class="btn-luxury-favorite @(ViewBag.IsFavorite ? "is-favorite" : "")">
                                <i class="fas fa-heart"></i>
                                <span>@(ViewBag.IsFavorite ? "Quitar de Favoritos" : "Agregar a Favoritos")</span>
                            </button>
                        </form>
                    }
                    else if (ViewBag.IsAuthenticated == false)
                    {
                        <div class="info-box-luxury">
                            <div class="info-icon-luxury">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <p>Inicia sesión para chatear con el agente y hacer ofertas</p>
                            <a href="@Url.Action("Login", "Account")" class="btn-luxury-login">
                                <i class="fas fa-sign-in-alt"></i>
                                Iniciar Sesión
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="info-box-luxury">
                            <div class="info-icon-luxury">
                                <i class="fas fa-user-tie"></i>
                            </div>
                            <p>Los agentes no pueden chatear o hacer ofertas sobre propiedades</p>
                        </div>
                    }

                    <!-- Back Button -->
                    <a href="@Url.Action("Index", "Home")" class="btn-luxury-back">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver al Inicio</span>
                    </a>
                </div>

            </div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentSlide = 0;
            const slides = document.querySelectorAll('.carousel-item');
            const dots = document.querySelectorAll('.carousel-dot');
            let autoplayInterval;

            if (slides.length === 0) {
                console.log('No hay imágenes en el carrusel');
                return;
            }

            function showSlide(index) {
                slides.forEach((slide, i) => {
                    if (i === index) {
                        slide.classList.add('active');
                    } else {
                        slide.classList.remove('active');
                    }
                });

                if (dots.length > 0) {
                    dots.forEach((dot, i) => {
                        if (i === index) {
                            dot.classList.add('active');
                        } else {
                            dot.classList.remove('active');
                        }
                    });
                }

                currentSlide = index;
            }

            window.nextSlide = function () {
                const next = (currentSlide + 1) % slides.length;
                showSlide(next);
            }

            window.prevSlide = function () {
                const prev = (currentSlide - 1 + slides.length) % slides.length;
                showSlide(prev);
            }

            window.goToSlide = function (index) {
                showSlide(index);
                resetAutoplay();
            }

            function resetAutoplay() {
                clearInterval(autoplayInterval);
                startAutoplay();
            }

            function startAutoplay() {
                if (slides.length > 1) {
                    autoplayInterval = setInterval(window.nextSlide, 5000);
                }
            }

            showSlide(0);
            startAutoplay();

            const carouselContainer = document.querySelector('.carousel-container');
            if (carouselContainer) {
                carouselContainer.addEventListener('mouseenter', () => {
                    clearInterval(autoplayInterval);
                });
                carouselContainer.addEventListener('mouseleave', () => {
                    startAutoplay();
                });
            }
        });
    </script>
}
