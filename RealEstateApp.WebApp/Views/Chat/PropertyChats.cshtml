@model List<RealEstateApp.Application.Dtos.Messages.MessageDto>
@{
    ViewData["Title"] = "Chats de Propiedad";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="flex">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg min-h-screen">
            <div class="p-6 bg-gradient-to-r from-blue-600 to-indigo-600">
                <h3 class="text-white font-bold text-lg">Panel del Agente</h3>
            </div>
            <nav class="mt-6">
                <a href="@Url.Action("Dashboard", "Agent")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-home w-5 mr-3"></i> Home del agente
                </a>
                <a href="@Url.Action("Profile", "Agent")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-user w-5 mr-3"></i> Mi perfil
                </a>
                <a href="@Url.Action("Properties", "Agent")" class="flex items-center px-6 py-3 bg-blue-50 text-blue-600 border-r-4 border-blue-600">
                    <i class="fas fa-building w-5 mr-3"></i> Mantenimiento de propiedades
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 mr-3"></i> Cerrar sesión
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 mb-2">Mensajes de Clientes</h1>
                        <p class="text-gray-600">
                            Propiedad: <span class="font-semibold">@ViewBag.Property?.Code</span> - 
                            @ViewBag.Property?.PropertyType?.Name
                        </p>
                    </div>
                    <a href="@Url.Action("Properties", "Agent")" 
                       class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors flex items-center">
                        <i class="fas fa-arrow-left mr-2"></i> Volver a Propiedades
                    </a>
                </div>
            </div>

            <!-- Listado de Clientes con Chats -->
            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                    <h2 class="text-2xl font-bold text-white">Clientes con Conversaciones</h2>
                </div>
                
                <div class="p-8">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-12">
                            <i class="fas fa-comments text-6xl text-gray-300 mb-4"></i>
                            <h3 class="text-xl font-semibold text-gray-600 mb-2">Sin conversaciones aún</h3>
                            <p class="text-gray-500">Cuando los clientes envíen mensajes, aparecerán aquí</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var message in Model.OrderByDescending(m => m.SentDate))
                            {
                                <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow cursor-pointer"
                                     onclick="window.location.href='@Url.Action("AgentChat", new { propertyId = message.PropertyId, clientId = message.SenderId })'">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center flex-1">
                                            <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold mr-4">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div class="flex-1">
                                                <h3 class="text-lg font-semibold text-gray-800">@message.SenderName</h3>
                                                <p class="text-sm text-gray-600 truncate">@message.Content</p>
                                            </div>
                                        </div>
                                        <div class="text-right ml-4">
                                            <p class="text-sm text-gray-500">@message.TimeAgo</p>
                                            <div class="mt-1">
                                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                    <i class="fas fa-envelope mr-1"></i> @Model.Count(m => m.SenderId == message.SenderId) mensajes
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
