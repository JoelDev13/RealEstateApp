@using RealEstateApp.WebApp.Models.Chat
@{
    ViewData["Title"] = "Chats de Propiedad";
    var property = ViewBag.Property as RealEstateApp.Application.Dtos.Property.PropertyDto;
    var chatSummaries = ViewBag.ChatSummaries as List<ChatSummaryViewModel>;
}

<link rel="stylesheet" href="~/css/chat.css" />

<div class="chat-page">
    <div class="chat-container">
        <div class="chat-header">
            <div class="chat-header-top">
                <div class="chat-header-title-section">
                    <a href="@Url.Action("Details", "Property", new { id = property.Id })"
                       class="chat-back-link">
                        <i class="fas fa-arrow-left"></i> Volver a detalles de propiedad
                    </a>
                    <h1 class="chat-title">Mensajes de Clientes</h1>
                    <p class="chat-subtitle">
                        Propiedad: <span class="chat-subtitle-highlight">@property.Code</span> -
                        @property.PropertyType
                    </p>
                </div>
            </div>
        </div>

        <div class="chat-box">
            <div class="chat-box-header">
                <div class="chat-avatar">
                    <i class="fas fa-comments"></i>
                </div>
                <div class="chat-user-info">
                    <h2>Conversaciones Activas</h2>
                    <p class="chat-user-status">
                        @if (chatSummaries != null && chatSummaries.Any())
                        {
                            <text>@chatSummaries.Count @(chatSummaries.Count == 1 ? "conversación" : "conversaciones")</text>
                        }
                        else
                        {
                            <text>Sin conversaciones</text>
                        }
                    </p>
                </div>
            </div>

            <div class="chat-messages-area">
                @if (chatSummaries == null || !chatSummaries.Any())
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">
                            <i class="fas fa-comments"></i>
                        </div>
                        <h3 class="chat-empty-title">Sin conversaciones aún</h3>
                        <p class="chat-empty-text">Cuando los clientes envíen mensajes sobre esta propiedad, aparecerán aquí</p>
                    </div>
                }
                else
                {
                    <div class="chats-list">
                        @foreach (var chat in chatSummaries.OrderByDescending(c => c.LastMessageDate))
                        {
                            <a href="@Url.Action("AgentChat", "Chat", new { propertyId = property.Id, clientId = chat.ClientId })"
                               class="chat-list-item">
                                <div class="chat-list-item-left">
                                    <div class="chat-list-avatar">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="chat-list-info">
                                        <h3 class="chat-list-name">@chat.ClientName</h3>
                                        <p class="chat-list-preview">@chat.LastMessage</p>
                                    </div>
                                </div>
                                <div class="chat-list-item-right">
                                    <span class="chat-list-time">@chat.LastMessageDate.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span class="chat-list-badge">
                                        <i class="fas fa-comment-dots"></i> Ver chat
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Ocultar alertas del layout
            const layoutToasts = document.querySelectorAll('.alert-toast');
            layoutToasts.forEach(toast => {
                if (!toast.closest('.chat-page')) {
                    toast.style.display = 'none';
                }
            });
        });
    </script>
}
