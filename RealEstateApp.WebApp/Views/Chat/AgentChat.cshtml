@model List<RealEstateApp.Application.Dtos.Messages.MessageDto>
@{
    ViewData["Title"] = "Chat con Cliente";
    var property = ViewBag.Property as RealEstateApp.Application.Dtos.Property.PropertyDto;
    var clientId = ViewBag.ClientId as string;
    var clientName = ViewBag.ClientName as string;
}

<link rel="stylesheet" href="~/css/chat.css" />

<div class="chat-page">
    <div class="chat-container">
        <div class="chat-header">
            <div class="chat-header-top">
                <div class="chat-header-title-section">
                    <a href="@Url.Action("PropertyChats", "Chat", new { propertyId = property.Id })"
                       class="chat-back-link">
                        <i class="fas fa-arrow-left"></i> Volver a todos los chats
                    </a>
                    <h1 class="chat-title">Chat con @clientName</h1>
                    <p class="chat-subtitle">
                        Propiedad: <span class="chat-subtitle-highlight">@property.Code</span> -
                        @property.PropertyType
                    </p>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                <i class="fas fa-check-circle"></i>
                <p>@TempData["Success"]</p>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">
                <i class="fas fa-exclamation-triangle"></i>
                <p>@TempData["Error"]</p>
            </div>
        }

        <div class="chat-box">
            <div class="chat-box-header">
                <div class="chat-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div class="chat-user-info">
                    <h2>@clientName</h2>
                    <p class="chat-user-status">Cliente</p>
                </div>
            </div>

            <div class="chat-messages-area" id="messagesArea">
                @if (!Model.Any())
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">
                            <i class="fas fa-comments"></i>
                        </div>
                        <h3 class="chat-empty-title">Sin mensajes aún</h3>
                        <p class="chat-empty-text">Sé el primero en iniciar la conversación con este cliente</p>
                    </div>
                }
                else
                {
                    <div class="chat-messages-list">
                        @foreach (var message in Model.OrderBy(m => m.SentDate))
                        {
                            <div class="chat-message @(message.IsFromAgent ? "from-me" : "from-other")">
                                <div class="chat-message-content">
                                    <div class="chat-message-bubble">
                                        <p class="chat-message-text">@message.Content</p>
                                    </div>
                                    <div class="chat-message-meta">
                                        <span class="chat-message-time">@message.TimeAgo</span>
                                        @if (message.IsFromAgent)
                                        {
                                            <span class="chat-message-sender">• Tú</span>
                                        }
                                        else
                                        {
                                            <span class="chat-message-sender">• @clientName</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="chat-input-area">
                <form asp-action="Send" asp-controller="Chat" method="post" class="chat-input-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@property.Id" />
                    <input type="hidden" name="ReceiverId" value="@clientId" />

                    <div class="chat-input-field">
                        <textarea name="Content"
                                  id="messageInput"
                                  rows="1"
                                  class="chat-textarea"
                                  placeholder="Escribe tu respuesta..."
                                  required></textarea>
                    </div>

                    <button type="submit" class="btn-send-message">
                        <i class="fas fa-paper-plane"></i> Enviar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Ocultar alertas del layout
            const layoutToasts = document.querySelectorAll('.alert-toast');
            layoutToasts.forEach(toast => {
                if (!toast.closest('.chat-page')) {
                    toast.style.display = 'none';
                }
            });

            // Auto-scroll al último mensaje
            const messagesArea = document.getElementById('messagesArea');
            if (messagesArea) {
                messagesArea.scrollTop = messagesArea.scrollHeight;
            }
        });

        // Auto-resize del textarea
        const textarea = document.getElementById('messageInput');
        if (textarea) {
            textarea.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });

            // Enviar con Enter (sin Shift)
            textarea.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    this.closest('form').submit();
                }
            });
        }

        // Auto-ocultar alertas después de 5 segundos
        setTimeout(function () {
            const alerts = document.querySelectorAll('.alert-success, .alert-error');
            alerts.forEach(function (alert) {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(function () {
                    alert.remove();
                }, 500);
            });
        }, 5000);
    </script>
}
