@model List<RealEstateApp.Application.Dtos.Messages.MessageDto>
@{
    ViewData["Title"] = "Chat";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="flex">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg min-h-screen">
            <div class="p-6 bg-gradient-to-r from-blue-600 to-indigo-600">
                <h3 class="text-white font-bold text-lg">Panel del Cliente</h3>
            </div>
            <nav class="mt-6">
                <a href="@Url.Action("Index", "Home")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-home w-5 mr-3"></i> Home
                </a>
                <a href="@Url.Action("Profile", "Account")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-user w-5 mr-3"></i> Mi perfil
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 mr-3"></i> Cerrar sesión
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="flex items-center mb-2">
                            <a href="@Url.Action("Details", "Property", new { id = ViewBag.Property?.Id })" 
                               class="text-blue-600 hover:text-blue-800 mr-2">
                                <i class="fas fa-arrow-left mr-1"></i> Volver a Propiedad
                            </a>
                            <h1 class="text-3xl font-bold text-gray-800">Chat con Agente</h1>
                        </div>
                        <p class="text-gray-600">
                            Propiedad: <span class="font-semibold">@ViewBag.Property?.Code</span> - 
                            @ViewBag.Property?.PropertyType?.Name | Agente: <span class="font-semibold">@ViewBag.AgentName</span>
                        </p>
                    </div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-lg">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-500 mr-3"></i>
                        <p class="text-green-700">@TempData["Success"]</p>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-triangle text-red-500 mr-3"></i>
                        <p class="text-red-700">@TempData["Error"]</p>
                    </div>
                </div>
            }

            <!-- Chat Container -->
            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <!-- Chat Header -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                    <div class="flex items-center">
                        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mr-4">
                            <i class="fas fa-user-tie text-blue-600 text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-white">Agente Inmobiliario</h2>
                            <p class="text-blue-100">En línea</p>
                        </div>
                    </div>
                </div>

                <!-- Messages Area -->
                <div class="h-96 overflow-y-auto p-6 bg-gray-50">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-8">
                            <i class="fas fa-comments text-6xl text-gray-300 mb-4"></i>
                            <h3 class="text-xl font-semibold text-gray-600 mb-2">Sin mensajes aún</h3>
                            <p class="text-gray-500">Sé el primero en iniciar la conversación</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var message in Model.OrderBy(m => m.SentDate))
                            {
                                <div class="flex @(message.IsFromAgent ? "justify-start" : "justify-end")">
                                    <div class="max-w-xs lg:max-w-md">
                                        <div class="@(message.IsFromAgent ? "bg-white border border-gray-200" : "bg-gradient-to-r from-blue-600 to-indigo-600 text-white") 
                                                    rounded-lg px-4 py-3 shadow-sm">
                                            <p class="@(message.IsFromAgent ? "text-gray-800" : "text-white")">@message.Content</p>
                                        </div>
                                        <div class="flex items-center mt-1 @(message.IsFromAgent ? "justify-start" : "justify-end")">
                                            <span class="text-xs text-gray-500">@message.TimeAgo</span>
                                            @if (message.IsFromAgent)
                                            {
                                                <span class="text-xs text-gray-400 ml-2">• Agente</span>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-gray-400 ml-2">• Tú</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Message Input -->
                <div class="border-t border-gray-200 p-4 bg-white">
                    <form asp-action="Send" method="post" class="flex items-end space-x-3">
                        <input type="hidden" name="PropertyId" value="@ViewBag.Property?.Id" />
                        <input type="hidden" name="ReceiverId" value="@ViewBag.AgentId" />
                        
                        <div class="flex-1">
                            <textarea name="Content" 
                                      rows="2" 
                                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none" 
                                      placeholder="Escribe tu mensaje..." 
                                      required></textarea>
                        </div>
                        
                        <button type="submit" 
                                class="px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all transform hover:scale-105 flex items-center">
                            <i class="fas fa-paper-plane mr-2"></i> Enviar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-scroll al último mensaje
        document.addEventListener('DOMContentLoaded', function() {
            const messagesArea = document.querySelector('.h-96.overflow-y-auto');
            if (messagesArea) {
                messagesArea.scrollTop = messagesArea.scrollHeight;
            }
        });

        const textarea = document.querySelector('textarea[name="Content"]');
        if (textarea) {
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        }
    </script>
}
