@model List<RealEstateApp.Application.Dtos.Messages.MessageDto>
@{
    ViewData["Title"] = "Chat con Agente";
}

<link rel="stylesheet" href="~/css/chat.css" />

<div class="chat-page">
    <div class="chat-container">
        <div class="chat-header">
            <div class="chat-header-top">
                <div class="chat-header-title-section">
                    <a href="@Url.Action("Details", "PublicProperty", new { id = ViewBag.Property?.Id })"
                       class="chat-back-link">
                        <i class="fas fa-arrow-left"></i> Volver a la propiedad
                    </a>
                    <h1 class="chat-title">Chat con Agente</h1>
                    <p class="chat-subtitle">
                        Propiedad: <span class="chat-subtitle-highlight">@ViewBag.Property?.Code</span> -
                        @ViewBag.Property?.PropertyType?.Name |
                        Agente: <span class="chat-subtitle-highlight">@ViewBag.AgentName</span>
                    </p>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">
                <i class="fas fa-check-circle"></i>
                <p>@TempData["Success"]</p>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-error">
                <i class="fas fa-exclamation-triangle"></i>
                <p>@TempData["Error"]</p>
            </div>
        }

        <div class="chat-box">
            <div class="chat-box-header">
                <div class="chat-avatar">
                    @if (!string.IsNullOrEmpty(ViewBag.AgentProfilePicture))
                    {
                        <img src="@ViewBag.AgentProfilePicture"
                             alt="@ViewBag.AgentName"
                             style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                    }
                    else
                    {
                        <i class="fas fa-user-tie"></i>
                    }
                </div>
                <div class="chat-user-info">
                    <h2>@ViewBag.AgentName</h2>
                    <p class="chat-user-status">Agente Inmobiliario</p>
                </div>
            </div>

            <div class="chat-messages-area" id="messagesArea">
                @if (!Model.Any())
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">
                            <i class="fas fa-comments"></i>
                        </div>
                        <h3 class="chat-empty-title">Sin mensajes aún</h3>
                        <p class="chat-empty-text">Sé el primero en iniciar la conversación con el agente</p>
                    </div>
                }
                else
                {
                    <div class="chat-messages-list">
                        @foreach (var message in Model.OrderBy(m => m.SentDate))
                        {
                            <div class="chat-message @(message.IsFromAgent ? "from-other" : "from-me")">
                                <div class="chat-message-content">
                                    <div class="chat-message-bubble">
                                        <p class="chat-message-text">@message.Content</p>
                                    </div>
                                    <div class="chat-message-meta">
                                        <span class="chat-message-time">@message.TimeAgo</span>
                                        @if (message.IsFromAgent)
                                        {
                                            <span class="chat-message-sender">• Agente</span>
                                        }
                                        else
                                        {
                                            <span class="chat-message-sender">• Tú</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="chat-input-area">
                <form asp-action="Send" asp-controller="Chat" method="post" class="chat-input-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PropertyId" value="@ViewBag.Property?.Id" />
                    <input type="hidden" name="ReceiverId" value="@ViewBag.AgentId" />

                    <div class="chat-input-field">
                        <textarea name="Content"
                                  id="messageInput"
                                  rows="1"
                                  class="chat-textarea"
                                  placeholder="Escribe tu mensaje..."
                                  required></textarea>
                    </div>

                    <button type="submit" class="btn-send-message">
                        <i class="fas fa-paper-plane"></i> Enviar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const layoutToasts = document.querySelectorAll('.alert-toast');
            layoutToasts.forEach(toast => {
                if (! toast.closest('.chat-page')) {
                    toast.style.display = 'none';
                }
            });

            const messagesArea = document.getElementById('messagesArea');
            if (messagesArea) {
                messagesArea.scrollTop = messagesArea.scrollHeight;
            }
        });

        const textarea = document.getElementById('messageInput');
        if (textarea) {
            textarea. addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });

            textarea.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    this. closest('form').submit();
                }
            });
        }

        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert-success, .alert-error');
            alerts.forEach(function(alert) {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(function() {
                    alert.remove();
                }, 500);
            });
        }, 5000);
    </script>
}
