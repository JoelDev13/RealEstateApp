@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/luxury-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luxury-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luxury-components.css" asp-append-version="true" />
</head>
<body>
    <div class="access-denied-page">
        <div class="access-denied-content">
            <div class="access-denied-icon">
                <i class="fas fa-ban"></i>
            </div>

            <h1 class="access-denied-title">Acceso Denegado</h1>

            <p class="access-denied-message">
                No tienes permisos para acceder a esta página. Si crees que esto es
                un error, por favor contacta al administrador del sistema.
            </p>

            <div class="access-denied-actions">
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
                    <i class="fas fa-home"></i>
                    Ir al inicio
                </a>

                <form asp-action="Logout" asp-controller="Account" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline">
                        <i class="fas fa-sign-out-alt"></i>
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
