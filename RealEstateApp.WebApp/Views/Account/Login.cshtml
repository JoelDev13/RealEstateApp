@model RealEstateApp.Application.Dtos.Auth.LoginRequestDto
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/luxury-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luxury-auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <!-- Left Branding Section -->
        <div class="auth-branding">
            <div class="auth-branding-content">
                <div class="auth-logo">
                    <div class="auth-logo-icon">
                        <img src="~/images/logo.png" alt="RealEstate Logo" class="auth-logo-img" />
                    </div>
                    <div class="auth-logo-text">
                        <span class="auth-logo-name">RealEstate</span>
                        <span class="auth-logo-tagline">Premium Properties</span>
                    </div>
                </div>

                <h1 class="auth-headline">
                    Encuentra tu <span>propiedad ideal</span> con nosotros
                </h1>

                <p class="auth-description">
                    Accede a las mejores propiedades del mercado. Desde apartamentos
                    exclusivos hasta residencias de lujo, tenemos lo que buscas.
                </p>

                <div class="auth-features">
                    <div class="auth-feature">
                        <i class="fas fa-shield-alt"></i>
                        <span>Transacciones seguras y verificadas</span>
                    </div>
                    <div class="auth-feature">
                        <i class="fas fa-users"></i>
                        <span>Agentes certificados a tu servicio</span>
                    </div>
                    <div class="auth-feature">
                        <i class="fas fa-home"></i>
                        <span>Miles de propiedades disponibles</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Form Section -->
        <div class="auth-form-section">
            <div class="auth-form-container">
                <div class="auth-form-header">
                    <div class="auth-form-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <h2 class="auth-form-title">Bienvenido de nuevo</h2>
                    <p class="auth-form-subtitle">Ingresa a tu cuenta para continuar</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="auth-alert auth-alert-success">
                        <i class="fas fa-check-circle"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="auth-alert auth-alert-error">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                <form class="auth-form" asp-action="Login" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error" style="display: none;"></div>

                    <div class="auth-form-group">
                        <label asp-for="UserName" class="auth-form-label">Email o Usuario</label>
                        <div class="auth-form-input-wrapper">
                            <i class="fas fa-at"></i>
                            <input asp-for="UserName" class="auth-form-input" placeholder="correo@ejemplo.com">
                        </div>
                        <span asp-validation-for="UserName" class="auth-form-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label asp-for="Password" class="auth-form-label">Contraseña</label>
                        <div class="auth-form-input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" type="password" class="auth-form-input" placeholder="Tu contraseña">
                        </div>
                        <span asp-validation-for="Password" class="auth-form-error"></span>
                    </div>

                    <div style="text-align: right;">
                        <a asp-action="ForgotPassword" asp-controller="Account" class="auth-forgot-link">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button type="submit" class="auth-submit-btn">
                        <i class="fas fa-sign-in-alt"></i>
                        Iniciar Sesión
                    </button>

                    <div class="auth-form-footer">
                        <p class="auth-form-link">
                            ¿No tienes cuenta?
                            <a asp-action="Register" asp-controller="Account">Regístrate gratis</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
