@model RealEstateApp.Application.Dtos.Auth.UserSaveDto
@{
    ViewData["Title"] = "Registro";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
                Crear cuenta
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Únete a RealEstateApp y encuentra tu propiedad ideal
            </p>
        </div>
        <form class="mt-8 space-y-6" asp-action="Register" asp-controller="Account" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>
            
            <!-- Información Personal -->
            <div class="space-y-4">
                <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Información Personal</h3>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-gray-700">Nombre</label>
                        <input asp-for="FirstName" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="Tu nombre">
                        <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
                    </div>
                    
                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-gray-700">Apellido</label>
                        <input asp-for="LastName" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="Tu apellido">
                        <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700">Teléfono</label>
                    <input asp-for="PhoneNumber" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="809-123-4567">
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="Cedula" class="block text-sm font-medium text-gray-700">Cédula <span class="text-red-500">*</span></label>
                    <input asp-for="Cedula" type="text" maxlength="11" pattern="[0-9]{11}" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="00000000000" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)">
                    <span asp-validation-for="Cedula" class="text-red-500 text-xs"></span>
                    <p class="text-xs text-gray-500 mt-1">Debe tener exactamente 11 dígitos numéricos</p>
                </div>

                <div>
                    <label asp-for="ProfilePicture" class="block text-sm font-medium text-gray-700">Foto de perfil</label>
                    <input type="file" name="profilePicture" accept="image/*" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm">
                    <p class="text-xs text-gray-500 mt-1">Formatos: JPG, PNG, GIF. Máximo 5MB</p>
                </div>
            </div>

            <!-- Credenciales -->
            <div class="space-y-4 pt-4">
                <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Credenciales</h3>
                
                <div>
                    <label asp-for="UserName" class="block text-sm font-medium text-gray-700">Nombre de usuario</label>
                    <input asp-for="UserName" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="nombredeusuario">
                    <span asp-validation-for="UserName" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700">Correo electrónico</label>
                    <input asp-for="Email" type="email" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="correo@ejemplo.com">
                    <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700">Contraseña</label>
                    <input asp-for="Password" type="password" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="Mínimo 8 caracteres">
                    <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirmar contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" class="mt-1 appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 focus:z-10 sm:text-sm" placeholder="Repite tu contraseña">
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <!-- Tipo de Usuario -->
            <div class="space-y-4 pt-4">
                <h3 class="text-lg font-medium text-gray-900 border-b pb-2">Tipo de Usuario</h3>
                
                <div>
                    <label asp-for="UserType" class="block text-sm font-medium text-gray-700">¿Cómo te registrarás?</label>
                    <select asp-for="UserType" class="mt-1 block w-full px-3 py-2 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                        <option value="">Selecciona una opción</option>
                        <option value="Cliente">Cliente - Buscar propiedades</option>
                        <option value="Agente">Agente - Publicar propiedades</option>
                    </select>
                    <span asp-validation-for="UserType" class="text-red-500 text-xs"></span>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-md p-3">
                    <p class="text-xs text-blue-800">
                        <strong>Cliente:</strong> Recibirás un email para activar tu cuenta.<br>
                        <strong>Agente:</strong> Tu cuenta será revisada por un administrador.
                    </p>
                </div>
            </div>

            <div>
                <button type="submit" class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150 ease-in-out">
                    Crear cuenta
                </button>
            </div>

            <div class="text-center">
                <p class="text-sm text-gray-600">
                    ¿Ya tienes cuenta? 
                    <a asp-action="Login" asp-controller="Account" class="font-medium text-indigo-600 hover:text-indigo-500">
                        Inicia sesión
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
