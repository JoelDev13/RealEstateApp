@model RealEstateApp.Application.Dtos.Auth.ResetPasswordRequestDto
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/luxury-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/luxury-auth.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <!-- Left Branding Section -->
        <div class="auth-branding">
            <div class="auth-branding-content">
                <div class="auth-logo">
                    <div class="auth-logo-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <div class="auth-logo-text">
                        <span class="auth-logo-name">RealEstate</span>
                        <span class="auth-logo-tagline">Premium Properties</span>
                    </div>
                </div>

                <h1 class="auth-headline">
                    Crea una nueva <span>contraseña</span> segura
                </h1>

                <p class="auth-description">
                    Elige una contraseña fuerte que no hayas usado antes para
                    mantener tu cuenta protegida.
                </p>

                <div class="auth-features">
                    <div class="auth-feature">
                        <i class="fas fa-check"></i>
                        <span>Mínimo 8 caracteres</span>
                    </div>
                    <div class="auth-feature">
                        <i class="fas fa-check"></i>
                        <span>Incluye números y letras</span>
                    </div>
                    <div class="auth-feature">
                        <i class="fas fa-check"></i>
                        <span>Usa caracteres especiales</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Form Section -->
        <div class="auth-form-section">
            <div class="auth-form-container">
                <div class="auth-form-header">
                    <div class="auth-form-icon">
                        <i class="fas fa-lock"></i>
                    </div>
                    <h2 class="auth-form-title">Nueva contraseña</h2>
                    <p class="auth-form-subtitle">Ingresa y confirma tu nueva contraseña</p>
                </div>

                <form class="auth-form" asp-action="ResetPassword" asp-controller="Account" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error"></div>

                    <div class="auth-form-group">
                        <label asp-for="Password" class="auth-form-label">Nueva contraseña</label>
                        <div class="auth-form-input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" type="password" class="auth-form-input" placeholder="Mínimo 8 caracteres">
                        </div>
                        <span asp-validation-for="Password" class="auth-form-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label asp-for="ConfirmPassword" class="auth-form-label">Confirmar contraseña</label>
                        <div class="auth-form-input-wrapper">
                            <i class="fas fa-lock"></i>
                            <input asp-for="ConfirmPassword" type="password" class="auth-form-input" placeholder="Repite tu nueva contraseña">
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-form-error"></span>
                    </div>

                    <button type="submit" class="auth-submit-btn">
                        <i class="fas fa-save"></i>
                        Restablecer contraseña
                    </button>

                    <div class="auth-form-footer">
                        <p class="auth-form-link">
                            <a asp-action="Login" asp-controller="Account">
                                <i class="fas fa-arrow-left"></i> Volver al inicio de sesión
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
