@model RealEstateApp.WebApp.Models.Agents.AgentListItemViewModel

@{
    ViewData["Title"] = "Eliminar agente";
}

<h1 class="mb-4">Eliminar agente</h1>

<div class="alert alert-warning">
    <h4 class="alert-heading">Confirmación requerida</h4>
    <p>
        ¿Está seguro que desea eliminar este agente y todas sus propiedades?
    </p>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">Propiedades</dt>
            <dd class="col-sm-9">@Model.PropertyCount</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-danger ms-2">Aceptar</button>
</form>
