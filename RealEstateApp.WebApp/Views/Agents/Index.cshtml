@model List<RealEstateApp.WebApp.Models.Agents.AgentListItemViewModel>

@{
    ViewData["Title"] = "Agentes";
    var totalAgents = Model?.Count ?? 0;
    var activeAgents = Model?.Count(a => a.IsActive) ?? 0;
    var inactiveAgents = Model?.Count(a => !a.IsActive) ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-title">
            <h1>Agentes</h1>
            <p class="page-header-subtitle">Gestiona los agentes inmobiliarios del sistema</p>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-card-icon stat-icon-gold">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@totalAgents</span>
            <span class="stat-card-label">Total</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon stat-icon-success">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@activeAgents</span>
            <span class="stat-card-label">Activos</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon stat-icon-error">
            <i class="fas fa-user-times"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@inactiveAgents</span>
            <span class="stat-card-label">Inactivos</span>
        </div>
    </div>
</div>

<!-- Search -->
<div class="card mb-4">
    <div class="card-body" style="padding: 1rem 1.5rem;">
        <form asp-action="Index" method="get" class="search-form">
            <div class="search-input-wrapper">
                <i class="fas fa-search"></i>
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-input"
                       placeholder="Buscar por nombre, apellido o correo..." />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i>
                Buscar
            </button>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-tie"></i>
            Lista de Agentes
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div class="data-table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Agente</th>
                            <th>Contacto</th>
                            <th class="text-center">Propiedades</th>
                            <th class="text-center">Estado</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model)
                        {
                            var initials = "";
                            var nameParts = agent.FullName?.Split(' ');
                            if (nameParts != null && nameParts.Length >= 2)
                            {
                                initials = $"{nameParts[0].FirstOrDefault()}{nameParts[1].FirstOrDefault()}".ToUpper();
                            }
                            else if (nameParts != null && nameParts.Length == 1)
                            {
                                initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
                            }

                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-cell-avatar">@initials</div>
                                        <div class="user-cell-info">
                                            <span class="user-cell-name">@agent.FullName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="contact-info">
                                        <span class="contact-email">
                                            <i class="fas fa-envelope"></i>
                                            @agent.Email
                                        </span>
                                        <span class="contact-phone">
                                            <i class="fas fa-phone"></i>
                                            @agent.PhoneNumber
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="property-count">@agent.PropertyCount</span>
                                </td>
                                <td class="text-center">
                                    @if (agent.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="fas fa-times-circle"></i>
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <form asp-action="ToggleStatus" asp-route-id="@agent.Id" method="post" class="inline-form"
                                              onsubmit="return confirm('¿Está seguro que desea @(agent.IsActive ? "inactivar" : "activar") este agente?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="action-btn @(agent.IsActive ? "action-btn-danger" : "action-btn-success")"
                                                    title="@(agent.IsActive ? "Inactivar" : "Activar")">
                                                <i class="fas @(agent.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@agent.Id"
                                           class="action-btn action-btn-danger"
                                           title="Eliminar">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h4 class="empty-state-title">No hay agentes registrados</h4>
                <p class="empty-state-description">Aún no se han registrado agentes en el sistema.</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .search-form {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .search-input-wrapper {
            flex: 1;
            position: relative;
        }

            .search-input-wrapper i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
            }

            .search-input-wrapper .form-input {
                padding-left: 2.75rem;
            }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            font-size: 0.8rem;
        }

        .contact-email,
        .contact-phone {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
        }

            .contact-email i,
            .contact-phone i {
                width: 14px;
                color: var(--text-muted);
                font-size: 0.75rem;
            }

        .property-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            background: var(--luxury-gold-muted);
            color: var(--luxury-gold);
            font-weight: 600;
            border-radius: var(--radius-md);
            font-size: 0.875rem;
        }
    </style>
}
