@model RealEstateApp.Web.Models.Admin.PropertyTypes.PropertyTypeCreateEditViewModel

@{
    ViewData["Title"] = "Editar Tipo de Propiedad";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-title">
            <nav class="breadcrumb-nav">
                <a asp-action="Index" class="breadcrumb-link">
                    <i class="fas fa-arrow-left"></i>
                    Volver a Tipos de Propiedad
                </a>
            </nav>
            <h1>Editar Tipo de Propiedad</h1>
            <p class="page-header-subtitle">Modifica la información del tipo de propiedad</p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-edit"></i>
            Información del Tipo de Propiedad
        </h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" class="form-luxury">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="form-validation-summary">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <!-- Sección: Información General -->
            <div class="form-section">
                <div class="form-section-header">
                    <i class="fas fa-info-circle"></i>
                    <span>Información General</span>
                </div>
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label asp-for="Name" class="form-label">
                            Nombre <span class="required">*</span>
                        </label>
                        <input asp-for="Name" class="form-input" placeholder="Ej: Casa, Apartamento, Local, etc." />
                        <span asp-validation-for="Name" class="form-error"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Description" class="form-label">Descripción</label>
                        <textarea asp-for="Description"
                                  class="form-input form-textarea"
                                  rows="4"
                                  placeholder="Descripción del tipo de propiedad..."></textarea>
                        <span asp-validation-for="Description" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i>
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .form-textarea {
            resize: vertical;
            min-height: 100px;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
