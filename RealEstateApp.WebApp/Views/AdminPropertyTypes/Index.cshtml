@model List<RealEstateApp.Web.Models.Admin.PropertyTypes.PropertyTypeViewModel>

@{
    ViewData["Title"] = "Tipos de Propiedad";
    var items = Model ?? new List<RealEstateApp.Web.Models.Admin.PropertyTypes.PropertyTypeViewModel>();
    var total = items.Count;
    var totalProperties = items.Sum(x => x.PropertiesCount);
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-title">
            <h1>Tipos de Propiedad</h1>
            <p class="page-header-subtitle">Gestiona los tipos de propiedad del sistema</p>
        </div>
        <div class="page-header-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                <span>Nuevo Tipo</span>
            </a>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-card-icon stat-icon-gold">
            <i class="fas fa-layer-group"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@total</span>
            <span class="stat-card-label">Tipos</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon stat-icon-success">
            <i class="fas fa-building"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@totalProperties</span>
            <span class="stat-card-label">Propiedades</span>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-layer-group"></i>
            Lista de Tipos de Propiedad
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (items.Any())
        {
            <div class="data-table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Propiedades</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <div class="item-name">
                                        <i class="fas fa-building"></i>
                                        <span>@item.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="item-description">@item.Description</span>
                                </td>
                                <td class="text-center">
                                    <span class="property-count">@item.PropertiesCount</span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="action-btn action-btn-edit"
                                           title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="action-btn action-btn-danger"
                                           title="Eliminar">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <h4 class="empty-state-title">No hay tipos de propiedad</h4>
                <p class="empty-state-description">Comienza creando el primer tipo de propiedad del sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Crear Tipo de Propiedad
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .item-name {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 600;
            color: var(--text-primary);
        }

            .item-name i {
                color: var(--luxury-gold);
                font-size: 0.875rem;
            }

        .item-description {
            color: var(--text-secondary);
            font-size: 0.875rem;
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: block;
        }

        .property-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
            background: var(--luxury-gold-muted);
            color: var(--luxury-gold);
            font-weight: 600;
            border-radius: var(--radius-md);
            font-size: 0.875rem;
        }
    </style>
}
