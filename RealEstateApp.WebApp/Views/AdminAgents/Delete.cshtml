@model RealEstateApp.WebApp.Models.Agents.AgentListItemViewModel

@{
    ViewData["Title"] = "Eliminar Agente";
    var initials = "";
    var nameParts = Model.FullName?.Split(' ');
    if (nameParts != null && nameParts.Length >= 2)
    {
        initials = $"{nameParts[0].FirstOrDefault()}{nameParts[1].FirstOrDefault()}".ToUpper();
    }
    else if (nameParts != null && nameParts.Length == 1)
    {
        initials = nameParts[0].Substring(0, Math.Min(2, nameParts[0].Length)).ToUpper();
    }
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-title">
            <nav class="breadcrumb-nav">
                <a asp-action="Index" class="breadcrumb-link">
                    <i class="fas fa-arrow-left"></i>
                    Volver a Agentes
                </a>
            </nav>
            <h1>Eliminar Agente</h1>
            <p class="page-header-subtitle">Esta acción no se puede deshacer</p>
        </div>
    </div>
</div>

<!-- Warning Alert -->
<div class="alert-card alert-card-danger">
    <div class="alert-card-icon">
        <i class="fas fa-exclamation-triangle"></i>
    </div>
    <div class="alert-card-content">
        <h4 class="alert-card-title">Confirmación requerida</h4>
        <p class="alert-card-text">¿Está seguro que desea eliminar este agente y todas sus propiedades? Esta acción es permanente.</p>
    </div>
</div>

<!-- Agent Info Card -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-tie"></i>
            Información del Agente
        </h3>
    </div>
    <div class="card-body">
        <div class="agent-delete-info">
            <div class="agent-delete-avatar">
                <div class="user-cell-avatar" style="width: 64px; height: 64px; font-size: 1.25rem;">@initials</div>
            </div>
            <div class="agent-delete-details">
                <div class="detail-row">
                    <span class="detail-label">Nombre</span>
                    <span class="detail-value">@Model.FullName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Correo</span>
                    <span class="detail-value">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Teléfono</span>
                    <span class="detail-value">@Model.PhoneNumber</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Propiedades</span>
                    <span class="detail-value">
                        <span class="property-count">@Model.PropertyCount</span>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Estado</span>
                    <span class="detail-value">
                        @if (Model.IsActive)
                        {
                            <span class="status-badge status-active">
                                <i class="fas fa-check-circle"></i>
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">
                                <i class="fas fa-times-circle"></i>
                                Inactivo
                            </span>
                        }
                    </span>
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="form-actions" style="justify-content: flex-start;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-times"></i>
                Cancelar
            </a>
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i>
                Eliminar Agente
            </button>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .alert-card {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.25rem 1.5rem;
            border-radius: var(--radius-lg);
            margin-bottom: 1.5rem;
        }

        .alert-card-danger {
            background: var(--status-error-light);
            border: 1px solid rgba(139, 58, 58, 0.2);
        }

        .alert-card-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.125rem;
            flex-shrink: 0;
            background: rgba(139, 58, 58, 0.15);
            color: var(--status-error);
        }

        .alert-card-content {
            flex: 1;
        }

        .alert-card-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--status-error);
            margin: 0 0 0.25rem 0;
        }

        .alert-card-text {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin: 0;
        }

        .agent-delete-info {
            display: flex;
            gap: 2rem;
            align-items: flex-start;
        }

        .agent-delete-details {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .detail-row {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .detail-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .detail-value {
            font-size: 0.9rem;
            color: var(--text-primary);
        }

        .property-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            height: 28px;
            background: var(--luxury-gold-muted);
            color: var(--luxury-gold);
            font-weight: 600;
            border-radius: var(--radius-md);
            font-size: 0.8rem;
        }

        .btn-danger {
            background: var(--status-error);
            color: white;
        }

            .btn-danger:hover {
                background: #7a3333;
            }

        @@media (max-width: 640px) {
            .agent-delete-info {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .agent-delete-details {
                grid-template-columns: 1fr;
            }
        }
    </style>
}
