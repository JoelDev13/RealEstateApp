@model RealEstateApp.WebApp.Models.Property.PropertyDetailViewModel
@{
    ViewData["Title"] = $"Detalles - {Model.Code}";
}

<link rel="stylesheet" href="~/css/PropertyDetails/property-details-base.css" />
<link rel="stylesheet" href="~/css/PropertyDetails/property-details-agent.css" />

<div class="details-page">
    <div class="details-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <a href="@Url.Action("Dashboard", "Agent")">Mi Dashboard</a>
            <span class="breadcrumb-separator"><i class="fas fa-chevron-right"></i></span>
            <span class="breadcrumb-current">@Model.Code</span>
        </nav>

        <!-- Details Grid -->
        <div class="details-grid">

            <!-- Main Column (Left) -->
            <div class="main-column">

                <!-- Image Gallery -->
                <div class="gallery-section">
                    @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                    {
                        <div class="carousel-container">
                            @foreach (var imageUrl in Model.ImageUrls)
                            {
                                <div class="carousel-item">
                                    <img src="@imageUrl" alt="@Model.Code" loading="lazy" />
                                </div>
                            }

                            @if (Model.ImageUrls.Count > 1)
                            {
                                <button class="carousel-btn carousel-btn-prev" onclick="prevSlide()" aria-label="Anterior">
                                    <i class="fas fa-chevron-left"></i>
                                </button>
                                <button class="carousel-btn carousel-btn-next" onclick="nextSlide()" aria-label="Siguiente">
                                    <i class="fas fa-chevron-right"></i>
                                </button>

                                <div class="carousel-dots">
                                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                                    {
                                        <button class="carousel-dot" onclick="goToSlide(@i)" aria-label="Ir a imagen @(i + 1)"></button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="carousel-placeholder">
                            <i class="fas fa-home"></i>
                            <p>Sin Imágenes Disponibles</p>
                        </div>
                    }
                </div>

                <!-- Property Info Card -->
                <div class="info-card">
                    <div class="info-header">
                        <div class="info-title-section">
                            <h1>@Model.Code</h1>
                            <div class="info-tags">
                                <span class="info-tag">
                                    <i class="fas fa-tag"></i>
                                    @Model.PropertyType
                                </span>
                                <span class="info-tag">
                                    <i class="fas fa-handshake"></i>
                                    @Model.SaleType
                                </span>
                            </div>
                        </div>
                        <div class="info-price-section">
                            <div class="price-amount">RD$@Model.Price.ToString("N0")</div>
                            <div class="price-currency">DOP</div>
                        </div>
                    </div>

                    <!-- Features Grid -->
                    <div class="features-grid">
                        <div class="feature-item">
                            <i class="fas fa-bed"></i>
                            <div>
                                <div class="feature-value">@Model.Bedrooms</div>
                                <div class="feature-label">Habitaciones</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-bath"></i>
                            <div>
                                <div class="feature-value">@Model.Bathrooms</div>
                                <div class="feature-label">Baños</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-ruler-combined"></i>
                            <div>
                                <div class="feature-value">@Model.Size</div>
                                <div class="feature-label">m²</div>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-info-circle"></i>
                            <div>
                                <div class="feature-value" style="font-size: 0.875rem;">
                                    @(Model.IsSold ? "Vendida" : "Disponible")
                                </div>
                                <div class="feature-label">Estado</div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="description-section">
                        <h3 class="section-title">Descripción</h3>
                        <p class="description-text">@Model.Description</p>
                    </div>

                    <!-- Improvements -->
                    @if (Model.Improvements != null && Model.Improvements.Any())
                    {
                        <div class="improvements-section">
                            <h3 class="section-title">Mejoras y Características</h3>
                            <div class="improvements-grid">
                                @foreach (var improvement in Model.Improvements)
                                {
                                    <div class="improvement-item">
                                        <div class="improvement-icon">
                                            <i class="fas fa-star"></i>
                                        </div>
                                        <span>@improvement</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

            </div>

            <!-- Sidebar Column (Right) -->
            <div class="sidebar-column">

                <!-- Agent Actions Card (Edit/Delete) -->
                @if (!Model.IsSold)
                {
                    <div class="actions-card-luxury agent-actions-card">
                        <a href="@Url.Action("Edit", "Property", new { id = Model.Id })" class="btn-luxury-primary">
                            <i class="fas fa-edit"></i>
                            <span>Editar Propiedad</span>
                        </a>
                        <button type="button" class="btn-luxury-danger" onclick="confirmDelete('@Model.Id', '@Model.Code')">
                            <i class="fas fa-trash"></i>
                            <span>Eliminar Propiedad</span>
                        </button>
                    </div>
                }

                <!-- Chats Card -->
                <div class="agent-card-luxury chats-card-agent">
                    <div class="agent-card-header">
                        <i class="fas fa-comments"></i>
                        <h3>Conversaciones</h3>
                    </div>
                    <div class="agent-card-body">
                        @if (Model.ClientChats != null && Model.ClientChats.Any())
                        {
                            <div class="clients-list-agent">
                                @foreach (var chat in Model.ClientChats.Take(3))
                                {
                                    <a href="@Url.Action("AgentChat", "Chat", new { propertyId = int.Parse(Model.Id), clientId = chat.ClientId })" class="client-item-agent">
                                        <div class="client-avatar-agent">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="client-info-agent">
                                            <span class="client-name-agent">@chat.ClientName</span>
                                            <span class="last-message-agent">@chat.LastMessage</span>
                                        </div>
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                }
                            </div>
                            <a href="@Url.Action("PropertyChats", "Chat", new { propertyId = int.Parse(Model.Id) })" class="btn-view-all-agent">
                                Ver Todas
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <div class="empty-state-agent">
                                <i class="fas fa-comments"></i>
                                <p>No hay conversaciones aún</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Offers Card -->
                <div class="agent-card-luxury offers-card-agent">
                    <div class="agent-card-header">
                        <i class="fas fa-hand-holding-usd"></i>
                        <h3>Ofertas Recibidas</h3>
                    </div>
                    <div class="agent-card-body">
                        @if (Model.ClientOffers != null && Model.ClientOffers.Any())
                        {
                            <div class="offers-list-agent">
                                @foreach (var offer in Model.ClientOffers.Take(3))
                                {
                                    <a href="@Url.Action("ClientOffers", "Offer", new { propertyId = int.Parse(Model.Id), clientId = offer.ClientId })" class="offer-item-agent">
                                        <div class="offer-left-agent">
                                            <div class="client-avatar-agent">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div class="offer-info-agent">
                                                <span class="client-name-agent">@offer.ClientName</span>
                                                <span class="offer-amount-agent">RD$@offer.LastOfferAmount.ToString("N0")</span>
                                            </div>
                                        </div>
                                        <div class="offer-right-agent">
                                            <span class="offer-status-agent @offer.Status.ToLower()">
                                                @offer.StatusText
                                            </span>
                                            <i class="fas fa-chevron-right"></i>
                                        </div>
                                    </a>
                                }
                            </div>
                            <a href="@Url.Action("AgentPropertyOffers", "Offer", new { propertyId = int.Parse(Model.Id) })" class="btn-view-all-agent">
                                Ver Todas
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <div class="empty-state-agent">
                                <i class="fas fa-hand-holding-usd"></i>
                                <p>No hay ofertas recibidas</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Back Button -->
                <div class="actions-card-luxury">
                    <a href="@Url.Action("Dashboard", "Agent")" class="btn-luxury-back">
                        <i class="fas fa-arrow-left"></i>
                        <span>Volver al Dashboard</span>
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentSlide = 0;
            const slides = document.querySelectorAll('.carousel-item');
            const dots = document.querySelectorAll('.carousel-dot');
            let autoplayInterval;

            if (slides.length === 0) {
                return;
            }

            function showSlide(index) {
                slides.forEach((slide, i) => {
                    if (i === index) {
                        slide.classList.add('active');
                    } else {
                        slide.classList.remove('active');
                    }
                });

                if (dots.length > 0) {
                    dots.forEach((dot, i) => {
                        if (i === index) {
                            dot.classList.add('active');
                        } else {
                            dot.classList.remove('active');
                        }
                    });
                }

                currentSlide = index;
            }

            window.nextSlide = function () {
                const next = (currentSlide + 1) % slides.length;
                showSlide(next);
            }

            window.prevSlide = function () {
                const prev = (currentSlide - 1 + slides.length) % slides.length;
                showSlide(prev);
            }

            window.goToSlide = function (index) {
                showSlide(index);
                resetAutoplay();
            }

            function resetAutoplay() {
                clearInterval(autoplayInterval);
                startAutoplay();
            }

            function startAutoplay() {
                if (slides.length > 1) {
                    autoplayInterval = setInterval(window.nextSlide, 5000);
                }
            }

            showSlide(0);
            startAutoplay();

            const carouselContainer = document.querySelector('.carousel-container');
            if (carouselContainer) {
                carouselContainer.addEventListener('mouseenter', () => {
                    clearInterval(autoplayInterval);
                });
                carouselContainer.addEventListener('mouseleave', () => {
                    startAutoplay();
                });
            }
        });

        function confirmDelete(propertyId, propertyCode) {
            if (confirm(`¿Está seguro que desea eliminar la propiedad ${propertyCode}?`)) {
                window.location.href = '@Url.Action("Delete", "Property")' + '?id=' + propertyId;
            }
        }
    </script>
}
