@model RealEstateApp.WebApp.Models.Property.CreatePropertyViewModel
@{
    ViewData["Title"] = "Crear Nueva Propiedad";
}

<link rel="stylesheet" href="~/css/luxury-components.css" />

<div style="background: var(--surface-primary); min-height: calc(100vh - 64px); padding: 3rem 0;">
    <div style="max-width: 1400px; margin: 0 auto; padding: 0 3rem;">

        <!-- Breadcrumb -->
        <div class="breadcrumb-nav">
            <a href="@Url.Action("Properties", "Agent")" class="breadcrumb-link">
                <i class="fas fa-arrow-left"></i> Volver a Mis Propiedades
            </a>
        </div>

        <!-- Page Header -->
        <div style="margin-bottom: 3rem;">
            <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.02em;">
                Crear Nueva Propiedad
            </h1>
            <p style="font-size: 1.125rem; color: var(--text-secondary);">
                Complete el formulario para agregar una nueva propiedad a su portafolio
            </p>
        </div>

        @* Validación:  Verificar que existan los catálogos necesarios *@
        @if (Model?.PropertyTypes == null || !Model.PropertyTypes.Any() ||
                Model?.SaleTypes == null || !Model.SaleTypes.Any() ||
                Model?.Improvements == null || !Model.Improvements.Any())
        {
            <div class="card">
                <div class="card-body" style="text-align: center; padding: 4rem;">
                    <div style="width: 100px; height: 100px; margin: 0 auto 2rem; background: var(--status-error-light); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: var(--status-error);"></i>
                    </div>
                    <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.25rem;">
                        No se puede crear una propiedad
                    </h3>
                    <p style="font-size: 1.0625rem; color: var(--text-secondary); margin-bottom: 2rem;">
                        Para crear una propiedad, primero debe existir:
                    </p>
                    <ul style="text-align: left; max-width: 450px; margin: 0 auto 2.5rem; font-size: 1rem; color: var(--text-secondary);">
                        @if (Model?.PropertyTypes == null || !Model.PropertyTypes.Any())
                        {
                            <li style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
                                <i class="fas fa-times-circle" style="color: var(--status-error); font-size: 1.125rem;"></i>
                                <span>Al menos un <strong>Tipo de Propiedad</strong></span>
                            </li>
                        }
                        @if (Model?.SaleTypes == null || !Model.SaleTypes.Any())
                        {
                            <li style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
                                <i class="fas fa-times-circle" style="color: var(--status-error); font-size: 1.125rem;"></i>
                                <span>Al menos un <strong>Tipo de Venta</strong></span>
                            </li>
                        }
                        @if (Model?.Improvements == null || !Model.Improvements.Any())
                        {
                            <li style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.75rem;">
                                <i class="fas fa-times-circle" style="color: var(--status-error); font-size: 1.125rem;"></i>
                                <span>Al menos una <strong>Mejora</strong></span>
                            </li>
                        }
                    </ul>
                    <a href="@Url.Action("Properties", "Agent")" class="btn btn-primary btn-lg">
                        <i class="fas fa-arrow-left"></i> Volver a Mis Propiedades
                    </a>
                </div>
            </div>
            return;
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-toast alert-toast-error" style="margin-bottom: 2rem;">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <!-- Form Card -->
        <div class="card">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <!-- Información Básica -->
                <div style="padding: 2.5rem 3rem; border-bottom: 1px solid var(--border-light);">
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                        <div style="width: 48px; height: 48px; background: var(--luxury-gold-muted); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-info-circle" style="color: var(--luxury-gold-dark); font-size: 1.25rem;"></i>
                        </div>
                        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin: 0;">
                            Información Básica
                        </h2>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
                        <div>
                            <label asp-for="PropertyTypeId" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Tipo de Propiedad <span style="color: var(--status-error);">*</span>
                            </label>
                            <select asp-for="PropertyTypeId" asp-items="Model.PropertyTypes"
                                    style="width: 100%; padding: 1rem 1.25rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); transition: all var(--transition-fast);">
                                <option value="">Seleccione un tipo...</option>
                            </select>
                            <span asp-validation-for="PropertyTypeId" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                        </div>

                        <div>
                            <label asp-for="SaleTypeId" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Tipo de Venta <span style="color: var(--status-error);">*</span>
                            </label>
                            <select asp-for="SaleTypeId" asp-items="Model.SaleTypes"
                                    style="width: 100%; padding: 1rem 1.25rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); transition: all var(--transition-fast);">
                                <option value="">Seleccione un tipo...</option>
                            </select>
                            <span asp-validation-for="SaleTypeId" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                        </div>
                    </div>
                </div>

                <!-- Detalles de la Propiedad -->
                <div style="padding: 2.5rem 3rem; border-bottom: 1px solid var(--border-light);">
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                        <div style="width: 48px; height: 48px; background: var(--luxury-gold-muted); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-home" style="color: var(--luxury-gold-dark); font-size: 1.25rem;"></i>
                        </div>
                        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin: 0;">
                            Detalles de la Propiedad
                        </h2>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
                        <div>
                            <label asp-for="Price" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Precio (RD$) <span style="color: var(--status-error);">*</span>
                            </label>
                            <div style="position: relative;">
                                <i class="fas fa-dollar-sign" style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1rem;"></i>
                                <input asp-for="Price" type="number" step="0.01" placeholder="15000000.00"
                                       style="width: 100%; padding: 1rem 1.25rem 1rem 3rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); transition: all var(--transition-fast);" />
                            </div>
                            <span asp-validation-for="Price" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                            <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.5rem;">
                                <i class="fas fa-info-circle"></i> Ingrese el precio en pesos dominicanos
                            </p>
                        </div>

                        <div>
                            <label asp-for="Size" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Tamaño (m²) <span style="color: var(--status-error);">*</span>
                            </label>
                            <div style="position: relative;">
                                <i class="fas fa-ruler-combined" style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1rem;"></i>
                                <input asp-for="Size" type="number" step="0.01" placeholder="250.50"
                                       style="width: 100%; padding: 1rem 1.25rem 1rem 3rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); transition: all var(--transition-fast);" />
                            </div>
                            <span asp-validation-for="Size" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                            <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.5rem;">
                                <i class="fas fa-info-circle"></i> Tamaño en metros cuadrados
                            </p>
                        </div>

                        <div>
                            <label asp-for="Bedrooms" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Habitaciones <span style="color: var(--status-error);">*</span>
                            </label>
                            <div style="position: relative;">
                                <i class="fas fa-bed" style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1rem;"></i>
                                <input asp-for="Bedrooms" type="number" min="0" placeholder="3"
                                       style="width: 100%; padding: 1rem 1.25rem 1rem 3rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); transition: all var(--transition-fast);" />
                            </div>
                            <span asp-validation-for="Bedrooms" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                        </div>

                        <div>
                            <label asp-for="Bathrooms" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Baños <span style="color: var(--status-error);">*</span>
                            </label>
                            <div style="position: relative;">
                                <i class="fas fa-bath" style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1rem;"></i>
                                <input asp-for="Bathrooms" type="number" min="0" placeholder="2"
                                       style="width: 100%; padding: 1rem 1.25rem 1rem 3rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); transition: all var(--transition-fast);" />
                            </div>
                            <span asp-validation-for="Bathrooms" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <div style="padding: 2.5rem 3rem; border-bottom: 1px solid var(--border-light);">
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                        <div style="width: 48px; height: 48px; background: var(--luxury-gold-muted); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-align-left" style="color: var(--luxury-gold-dark); font-size: 1.25rem;"></i>
                        </div>
                        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin: 0;">
                            Descripción
                        </h2>
                    </div>

                    <div>
                        <label asp-for="Description" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                            Descripción de la Propiedad <span style="color: var(--status-error);">*</span>
                        </label>
                        <textarea asp-for="Description" rows="6" placeholder="Describe las características principales de la propiedad, ubicación, amenidades cercanas, etc."
                                  style="width: 100%; padding: 1.25rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary); resize: vertical; font-family: inherit; line-height: 1.6;"></textarea>
                        <span asp-validation-for="Description" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.5rem;">
                            <i class="fas fa-info-circle"></i> Proporcione una descripción detallada de la propiedad
                        </p>
                    </div>
                </div>

                <!-- Características Adicionales -->
                <div style="padding: 2.5rem 3rem; border-bottom: 1px solid var(--border-light);">
                    <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
                        <div style="width: 48px; height: 48px; background: var(--luxury-gold-muted); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-star" style="color: var(--luxury-gold-dark); font-size: 1.25rem;"></i>
                        </div>
                        <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin: 0;">
                            Características Adicionales
                        </h2>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;">
                        <div>
                            <label asp-for="SelectedImprovementIds" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Mejoras <span style="color: var(--status-error);">*</span>
                            </label>
                            <select asp-for="SelectedImprovementIds" asp-items="Model.Improvements" multiple size="8"
                                    style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-medium); border-radius: var(--radius-md); font-size: 1rem; color: var(--text-primary); background: var(--surface-primary);">
                            </select>
                            <span asp-validation-for="SelectedImprovementIds" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                            <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.75rem;">
                                <i class="fas fa-info-circle"></i>
                                Mantenga presionado
                                <kbd style="background: var(--surface-sunken); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8125rem; font-weight: 600;">Ctrl</kbd>
                                (Windows) o
                                <kbd style="background: var(--surface-sunken); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8125rem; font-weight: 600;">Cmd</kbd>
                                (Mac) para seleccionar múltiples opciones
                            </p>
                        </div>

                        <div>
                            <label asp-for="Images" style="display: block; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">
                                Imágenes de la Propiedad <span style="color: var(--status-error);">*</span>
                            </label>
                            <div style="border: 2px dashed var(--border-medium); border-radius: var(--radius-lg); padding: 2.5rem; text-align: center; transition: all var(--transition-fast); cursor: pointer; background: var(--surface-sunken);"
                                 id="uploadArea"
                                 onclick="document.getElementById('ImagesInput').click()">
                                <i class="fas fa-cloud-upload-alt" id="uploadIcon" style="font-size: 3.5rem; color: var(--text-muted); margin-bottom: 1.25rem; display: block;"></i>
                                <p id="uploadText" style="color: var(--text-secondary); margin-bottom: 1.25rem; font-size: 1rem; font-weight: 500;">
                                    Arrastra imágenes aquí o haz clic para seleccionar
                                </p>
                                <input asp-for="Images" id="ImagesInput" type="file" multiple accept="image/*" style="display: none;" />
                                <button type="button" class="btn btn-secondary"
                                        onclick="event.stopPropagation(); document.getElementById('ImagesInput').click();">
                                    <i class="fas fa-folder-open"></i>
                                    Seleccionar Imágenes
                                </button>
                                <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 1.25rem;">
                                    <i class="fas fa-info-circle"></i>
                                    Mínimo 1 imagen, máximo 4. Formatos: JPG, PNG, GIF
                                </p>
                            </div>
                            <span asp-validation-for="Images" style="display: block; color: var(--status-error); font-size: 0.875rem; margin-top: 0.5rem;"></span>
                            <div id="imagePreview" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.25rem;"></div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div style="padding: 2.5rem 3rem; display: flex; align-items: center; justify-content: space-between;">
                    <a href="@Url.Action("Properties", "Agent")" class="btn btn-outline btn-lg">
                        <i class="fas fa-arrow-left"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg" style="padding: 1rem 3rem;">
                        <i class="fas fa-save"></i>
                        Crear Propiedad
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imagesInput = document.getElementById('ImagesInput');
        const uploadArea = document.getElementById('uploadArea');
        const uploadIcon = document.getElementById('uploadIcon');
        const uploadText = document.getElementById('uploadText');
        const imagePreview = document.getElementById('imagePreview');

        // Focus styles for inputs
        document.querySelectorAll('input, select, textarea').forEach(el => {
            el.addEventListener('focus', function () {
                this.style.borderColor = 'var(--luxury-gold)';
                this.style.boxShadow = '0 0 0 3px var(--luxury-gold-muted)';
            });
            el.addEventListener('blur', function () {
                this.style.borderColor = 'var(--border-medium)';
                this.style.boxShadow = 'none';
            });
        });

        // Drag and drop
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = 'var(--luxury-gold)';
            uploadArea.style.background = 'var(--luxury-gold-muted)';
        });

        uploadArea.addEventListener('dragleave', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = 'var(--border-medium)';
            uploadArea.style.background = 'var(--surface-sunken)';
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.style.borderColor = 'var(--border-medium)';
            uploadArea.style.background = 'var(--surface-sunken)';

            const files = e.dataTransfer.files;
            if (files.length > 0) {
                imagesInput.files = files;
                updateImagePreview(files);
            }
        });

        imagesInput.addEventListener('change', function (e) {
            const files = e.target.files;
            updateImagePreview(files);
        });

        function updateImagePreview(files) {
            const fileCount = files.length;

            if (fileCount > 4) {
                alert('Solo puedes seleccionar un máximo de 4 imágenes');
                imagesInput.value = '';
                resetUploadUI();
                return;
            }

            if (fileCount > 0) {
                uploadIcon.className = 'fas fa-check-circle';
                uploadIcon.style.color = 'var(--status-success)';
                uploadIcon.style.fontSize = '3.5rem';
                uploadText.textContent = `${fileCount} imagen(es) seleccionada(s)`;
                uploadText.style.color = 'var(--status-success)';
                uploadText.style.fontWeight = '600';

                imagePreview.innerHTML = '';
                for (let i = 0; i < fileCount; i++) {
                    const file = files[i];
                    const reader = new FileReader();

                    reader.onload = function (e) {
                        const img = document.createElement('div');
                        img.style.cssText = 'position: relative; border-radius: var(--radius-md); overflow: hidden; aspect-ratio: 1; border: 3px solid var(--border-light);';
                        img.innerHTML = `
                            <img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover;">
                            <div style="position: absolute; top: 8px; right: 8px; background: var(--luxury-gold); color: var(--luxury-black); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.875rem; font-weight: 700; box-shadow: var(--shadow-md);">${i + 1}</div>
                        `;
                        imagePreview.appendChild(img);
                    };

                    reader.readAsDataURL(file);
                }
            } else {
                resetUploadUI();
            }
        }

        function resetUploadUI() {
            uploadIcon.className = 'fas fa-cloud-upload-alt';
            uploadIcon.style.color = 'var(--text-muted)';
            uploadIcon.style.fontSize = '3.5rem';
            uploadText.textContent = 'Arrastra imágenes aquí o haz clic para seleccionar';
            uploadText.style.color = 'var(--text-secondary)';
            uploadText.style.fontWeight = '500';
            imagePreview.innerHTML = '';
        }

        // Auto-hide alerts
        setTimeout(() => {
            document.querySelectorAll('.alert-toast').forEach(alert => {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);
    </script>
}
