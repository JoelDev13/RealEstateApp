@model RealEstateApp.WebApp.Models.Property.EditPropertyViewModel
@{
    ViewData["Title"] = "Editar Propiedad";
}

<link rel="stylesheet" href="~/css/home-properties.css" />
<link rel="stylesheet" href="~/css/property-form.css" />

<div class="home-page">
    <div class="home-container" style="max-width: 1400px;">
        <div style="margin-bottom: 1.5rem;">
            <a href="@Url.Action("Properties", "Agent")" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Volver a Mantenimiento
            </a>
        </div>

        <div class="home-header" style="margin-bottom: 2rem;">
            <div>
                <h1 class="header-title">Editar Propiedad</h1>
                <p class="header-subtitle">Código: <span class="property-count">@Model.Code</span></p>
            </div>
        </div>

        <div class="form-card" style="max-width: 100%;">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-triangle"></i>
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Code" />

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-info-circle"></i>
                        Información General
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="PropertyTypeId" class="form-label">Tipo de Propiedad *</label>
                            <select asp-for="PropertyTypeId" asp-items="Model.PropertyTypes" class="form-input">
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="PropertyTypeId" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="SaleTypeId" class="form-label">Tipo de Venta *</label>
                            <select asp-for="SaleTypeId" asp-items="Model.SaleTypes" class="form-input">
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="SaleTypeId" class="form-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-ruler-combined"></i>
                        Características
                    </h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="Price" class="form-label">Precio (DOP) *</label>
                            <div class="input-with-icon">
                                <i class="fas fa-dollar-sign"></i>
                                <input asp-for="Price" class="form-input" type="number" step="0.01" placeholder="2,000,000" />
                            </div>
                            <span asp-validation-for="Price" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Size" class="form-label">Tamaño (m²) *</label>
                            <div class="input-with-icon">
                                <i class="fas fa-ruler-combined"></i>
                                <input asp-for="Size" class="form-input" type="number" step="0.01" placeholder="130.00" />
                            </div>
                            <span asp-validation-for="Size" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Bedrooms" class="form-label">Habitaciones *</label>
                            <div class="input-with-icon">
                                <i class="fas fa-bed"></i>
                                <input asp-for="Bedrooms" class="form-input" type="number" min="0" placeholder="3" />
                            </div>
                            <span asp-validation-for="Bedrooms" class="form-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Bathrooms" class="form-label">Baños *</label>
                            <div class="input-with-icon">
                                <i class="fas fa-bath"></i>
                                <input asp-for="Bathrooms" class="form-input" type="number" min="0" placeholder="2" />
                            </div>
                            <span asp-validation-for="Bathrooms" class="form-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-align-left"></i>
                        Descripción
                    </h3>
                    <div class="form-group">
                        <label asp-for="Description" class="form-label">Descripción de la propiedad *</label>
                        <textarea asp-for="Description" class="form-input" rows="5" placeholder="Describe las características principales de la propiedad..."></textarea>
                        <span asp-validation-for="Description" class="form-error"></span>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-star"></i>
                        Mejoras
                    </h3>
                    <div class="form-group">
                        <label asp-for="SelectedImprovementIds" class="form-label">Selecciona las mejoras disponibles</label>
                        <select asp-for="SelectedImprovementIds" asp-items="Model.Improvements" class="form-input" multiple size="8">
                        </select>
                        <small class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Mantenga presionado <kbd>Ctrl</kbd> (Windows) o <kbd>Cmd</kbd> (Mac) para seleccionar múltiples opciones
                        </small>
                        <span asp-validation-for="SelectedImprovementIds" class="form-error"></span>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="form-section-title">
                        <i class="fas fa-images"></i>
                        Imágenes
                    </h3>

                    @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                    {
                        <div class="current-images-section">
                            <label class="form-label">Imágenes actuales de la propiedad</label>
                            <div class="current-images-grid">
                                @foreach (var imageUrl in Model.ExistingImages)
                                {
                                    <div class="current-image-item">
                                        <img src="@imageUrl" alt="Imagen de propiedad" class="current-image" />
                                        <div class="current-image-overlay">
                                            <i class="fas fa-search-plus"></i>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="form-hint" style="margin-top: 1rem;">
                                <i class="fas fa-info-circle"></i>
                                Actualmente tienes <strong>@Model.ExistingImages.Count imagen@(Model.ExistingImages.Count > 1 ? "es" : "")</strong>
                            </div>
                        </div>
                    }

                    <div class="form-group" style="margin-top: 1.5rem;">
                        <label asp-for="NewImages" class="form-label">Cambiar imágenes (Opcional)</label>
                        <div class="file-input-wrapper">
                            <input asp-for="NewImages" class="file-input" type="file" multiple accept="image/*" id="imageUpload" />
                            <label for="imageUpload" class="file-input-label">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Seleccionar nuevas imágenes</span>
                                <small>Máximo 4 imágenes (JPG, PNG)</small>
                            </label>
                        </div>
                        <span asp-validation-for="NewImages" class="form-error"></span>
                        <div class="form-hint">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Importante:</strong> Si subes nuevas imágenes, se reemplazarán <strong>todas las actuales</strong>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Properties", "Agent")" class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imageUpload')?.addEventListener('change', function (e) {
            const fileLabel = this.nextElementSibling.querySelector('span');
            const fileCount = this.files.length;
            if (fileCount > 0) {
                fileLabel.textContent = `${fileCount} imagen${fileCount > 1 ? 'es' : ''} seleccionada${fileCount > 1 ? 's' : ''}`;
            } else {
                fileLabel.textContent = 'Seleccionar nuevas imágenes';
            }
        });
    </script>
}
