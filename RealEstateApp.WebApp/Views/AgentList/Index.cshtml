@model List<RealEstateApp.Application.Dtos.Auth.UserDto>

@{
    ViewData["Title"] = "Listado de Agentes";
}

<link rel="stylesheet" href="~/css/agents.css" />

<div class="agents-page">
    <div class="agents-container">
        <div class="agents-header">
            <div class="agents-header-content">
                <h1 class="agents-title"
                    style="color: #FFD95A; font-weight: 700; font-size: 1.4rem; margin-bottom: 0.3rem;">
                    Nuestros Agentes
                </h1>

                <p class="agents-subtitle"
                   style="color: #FFE9A6; font-size: 1.1rem; font-weight: 400;">
                    Encuentra al agente perfecto para ti
                </p>

            </div>
        </div>

        <div class="search-section">
            <form method="get" asp-action="Index" asp-controller="AgentList" class="search-form">
                <div class="search-field">
                    <label class="search-label">Buscar por nombre</label>
                    <input type="text"
                           name="searchName"
                           value="@ViewBag.SearchName"
                           class="search-input"
                           placeholder="Ej: Fernando, Olga, Manuel..." />
                </div>
                <div class="search-actions">
                    <button type="submit" class="btn-search">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <a href="@Url.Action("Index", "AgentList")" class="btn-clear">
                        <i class="fas fa-times"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state-agents">
                <div class="empty-state-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <h3 class="empty-state-title">No se encontraron agentes</h3>
                <p class="empty-state-text">Intenta con otro término de búsqueda</p>
            </div>
        }
        else
        {
            <div class="agents-grid">
                @foreach (var agent in Model.OrderBy(a => a.FirstName))
                {
                    <a href="@Url.Action("Properties", "AgentList", new { agentId = agent.Id })" class="agent-card">
                        <div class="agent-card-image">
                            @if (!string.IsNullOrEmpty(agent.ProfilePicture))
                            {
                                <img src="@agent.ProfilePicture" alt="@agent.FirstName @agent.LastName" />
                            }
                            else
                            {
                                <div class="agent-placeholder">
                                    <i class="fas fa-user-tie"></i>
                                </div>
                            }
                        </div>

                        <div class="agent-card-content">
                            <h3 class="agent-name">@agent.FirstName @agent.LastName</h3>

                            <div class="agent-contact">
                                <div class="agent-contact-item">
                                    <i class="fas fa-envelope"></i>
                                    <span>@agent.Email</span>
                                </div>
                                @if (!string.IsNullOrEmpty(agent.PhoneNumber))
                                {
                                    <div class="agent-contact-item">
                                        <i class="fas fa-phone"></i>
                                        <span>@agent.PhoneNumber</span>
                                    </div>
                                }
                            </div>

                            <div class="agent-card-action">
                                <span class="agent-view-properties">
                                    Ver Propiedades <i class="fas fa-arrow-right"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
