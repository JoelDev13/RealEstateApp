@model List<RealEstateApp.Application.Dtos.Property.PropertyDto>
@using RealEstateApp.Application.Dtos.Property
@{
    ViewData["Title"] = $"Propiedades de {ViewBag.Agent?.FirstName} {ViewBag.Agent?.LastName}";
    var filters = new PropertyFiltersDto
    {
        Code = ViewBag.SearchCode,
        PropertyTypeId = ViewBag.PropertyTypeId,
        MinPrice = ViewBag.MinPrice,
        MaxPrice = ViewBag.MaxPrice,
        Bedrooms = ViewBag.Bedrooms,
        Bathrooms = ViewBag.Bathrooms
    };
}

<link rel="stylesheet" href="~/css/agent-properties.css" />
<link rel="stylesheet" href="~/css/home-properties.css" />

<div class="agent-properties-page">
    <div class="agent-properties-container">
        <div class="agent-profile-header">
            <div class="agent-profile-avatar">
                @if (!string.IsNullOrEmpty(ViewBag.Agent?.ProfilePicture))
                {
                    <img src="@ViewBag.Agent.ProfilePicture" alt="@ViewBag.Agent.FirstName @ViewBag.Agent.LastName" />
                }
                else
                {
                    <i class="fas fa-user-tie agent-profile-avatar-placeholder"></i>
                }
            </div>
            <div class="agent-profile-info">
                <h1 class="agent-profile-name">@ViewBag.Agent?.FirstName @ViewBag.Agent?.LastName</h1>
                <div class="agent-profile-contact">
                    <div class="agent-profile-contact-item">
                        <i class="fas fa-envelope"></i>
                        <span>@ViewBag.Agent?.Email</span>
                    </div>
                    @if (!string.IsNullOrEmpty(ViewBag.Agent?.PhoneNumber))
                    {
                        <div class="agent-profile-contact-item">
                            <i class="fas fa-phone"></i>
                            <span>@ViewBag.Agent.PhoneNumber</span>
                        </div>
                    }
                </div>
            </div>
            <div class="agent-profile-actions">
                <a href="@Url.Action("Index", "AgentList")" class="btn-back-agents">
                    <i class="fas fa-arrow-left"></i> Volver a Agentes
                </a>
            </div>
        </div>

        <div class="filters-section">
            <form asp-action="Properties" asp-controller="AgentList" method="get" class="filters-form">
                <input type="hidden" name="agentId" value="@ViewBag.Agent?.Id" />
                @await Html.PartialAsync("_PropertyFilters", filters)
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-home"></i>
                </div>
                <h3 class="empty-title">No hay propiedades disponibles</h3>
                <p class="empty-text">Este agente no tiene propiedades que coincidan con los filtros</p>
            </div>
        }
        else
        {
            <div class="properties-grid">
                @foreach (var property in Model.OrderByDescending(p => p.CreatedAt))
                {
                    <article class="property-card">
                        <div class="card-image">
                            <span class="badge-type">@(!string.IsNullOrWhiteSpace(property.PropertyType) ? property.PropertyType : "Propiedad")</span>
                            <span class="badge-sale">@(!string.IsNullOrWhiteSpace(property.SaleType) ? property.SaleType : "Venta")</span>

                            @if (!string.IsNullOrEmpty(property.MainImageUrl))
                            {
                                <img src="@property.MainImageUrl" alt="@property.Code" class="card-img" loading="lazy">
                            }
                            else
                            {
                                <div class="card-img-placeholder">
                                    <i class="fas fa-home"></i>
                                </div>
                            }
                        </div>

                        <div class="card-content">
                            <p class="card-code">Código: @property.Code</p>

                            <div class="card-price">
                                RD$@property.Price.ToString("N0") <span class="currency">DOP</span>
                            </div>

                            <div class="card-features">
                                <div class="feature">
                                    <i class="fas fa-bed"></i>
                                    <span>@property.Bedrooms Hab.</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-bath"></i>
                                    <span>@property.Bathrooms Baños</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-ruler-combined"></i>
                                    <span>@property.Size m²</span>
                                </div>
                            </div>

                            <a href="@Url.Action("Details", "PublicProperty", new { id = property.Id })" class="btn-view-details">
                                Ver detalles <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
