@model IEnumerable<RealEstateApp.Web.Models.Admin.SaleTypes.SaleTypeViewModel>

@{
    ViewData["Title"] = "Tipos de Venta";
    var items = Model?.ToList() ?? new List<RealEstateApp.Web.Models.Admin.SaleTypes.SaleTypeViewModel>();
    var total = items.Count;
    var active = items.Count(x => x.IsActive);
    var inactive = items.Count(x => !x.IsActive);
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-title">
            <h1>Tipos de Venta</h1>
            <p class="page-header-subtitle">Gestiona los tipos de operación (Venta, Alquiler, etc.)</p>
        </div>
        <div class="page-header-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                <span>Nuevo Tipo</span>
            </a>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-card-icon stat-icon-gold">
            <i class="fas fa-tags"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@total</span>
            <span class="stat-card-label">Total</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-icon stat-icon-success">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@active</span>
            <span class="stat-card-label">Activos</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-icon stat-icon-error">
            <i class="fas fa-times-circle"></i>
        </div>
        <div class="stat-card-content">
            <span class="stat-card-value">@inactive</span>
            <span class="stat-card-label">Inactivos</span>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-tags"></i>
            Lista de Tipos de Venta
        </h3>
    </div>

    <div class="card-body" style="padding: 0;">
        @if (items.Any())
        {
            <div class="data-table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    <div class="item-name">
                                        <i class="fas fa-tag"></i>
                                        <span>@item.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="item-description">@item.Description</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="fas fa-times-circle"></i>
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="action-btn action-btn-edit"
                                           title="Editar">
                                            <i class="fas fa-pen"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="inline-form"
                                              onsubmit="return confirm('¿Está seguro que desea @(item.IsActive ? "desactivar" : "activar") este tipo?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="action-btn @(item.IsActive ? "action-btn-danger" : "action-btn-success")"
                                                    title="@(item.IsActive ? "Desactivar" : "Activar")">
                                                <i class="fas @(item.IsActive ? "fa-toggle-off" : "fa-toggle-on")"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline-form"
                                              onsubmit="return confirm('¿Está seguro que desea eliminar este tipo de venta?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="action-btn action-btn-danger"
                                                    title="Eliminar">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-tags"></i>
                </div>
                <h4 class="empty-state-title">No hay tipos de venta</h4>
                <p class="empty-state-description">Comienza creando el primer tipo de venta del sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Crear Tipo de Venta
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .item-name {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 600;
            color: var(--text-primary);
        }

            .item-name i {
                color: var(--luxury-gold);
                font-size: 0.875rem;
            }

        .item-description {
            color: var(--text-secondary);
            font-size: 0.875rem;
            max-width: 300px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            display: block;
        }
    </style>
}
