@model RealEstateApp.WebApp.Models.Admin.AdminUsers.AdminUserCreateViewModel

@{
    ViewData["Title"] = "Crear Administrador";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <div class="page-header-title">
            <nav class="breadcrumb-nav">
                <a asp-action="Index" class="breadcrumb-link">
                    <i class="fas fa-arrow-left"></i>
                    Volver a Administradores
                </a>
            </nav>
            <h1>
                <i class="fas fa-user-plus" style="color: var(--luxury-gold); margin-right: 0.5rem;"></i>
                Crear Administrador
            </h1>
            <p class="page-header-subtitle">
                <i class="fas fa-edit"></i>
                Completa el formulario para agregar un nuevo administrador
            </p>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-shield"></i>
            Información del Administrador
        </h3>
    </div>

    <div class="card-body">
        <form asp-action="Create" method="post" class="form-luxury">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="form-validation-summary">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <!-- Sección: Información Personal -->
            <div class="form-section">
                <div class="form-section-header">
                    <i class="fas fa-user"></i>
                    <span>Información Personal</span>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="FirstName" class="form-label">Nombre <span class="required">*</span></label>
                        <input asp-for="FirstName" class="form-input" placeholder="Ingresa el nombre" />
                        <span asp-validation-for="FirstName" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName" class="form-label">Apellido <span class="required">*</span></label>
                        <input asp-for="LastName" class="form-input" placeholder="Ingresa el apellido" />
                        <span asp-validation-for="LastName" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Cedula" class="form-label">Cédula <span class="required">*</span></label>
                        <input asp-for="Cedula" class="form-input" placeholder="000-0000000-0" />
                        <span asp-validation-for="Cedula" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Correo electrónico <span class="required">*</span></label>
                        <input asp-for="Email" type="email" class="form-input" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Sección: Credenciales -->
            <div class="form-section">
                <div class="form-section-header">
                    <i class="fas fa-lock"></i>
                    <span>Credenciales de Acceso</span>
                </div>

                <div class="form-grid">
                    <div class="form-group full-width">
                        <label asp-for="UserName" class="form-label">Nombre de usuario <span class="required">*</span></label>
                        <input asp-for="UserName" class="form-input" placeholder="nombredeusuario" />
                        <span class="form-hint">Este será el identificador único para iniciar sesión</span>
                        <span asp-validation-for="UserName" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Contraseña <span class="required">*</span></label>
                        <input asp-for="Password" type="password" class="form-input" placeholder="Mínimo 8 caracteres" />
                        <span class="form-hint">Debe contener mayúsculas, minúsculas, números y caracteres especiales</span>
                        <span asp-validation-for="Password" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña <span class="required">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Repite la contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="form-error"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i>
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    Crear Administrador
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
