@model RealEstateApp.WebApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="admin-dashboard-container">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-header-title">
                <h1>
                    <i class="fas fa-crown" style="color: var(--luxury-gold); margin-right: 0.5rem;"></i>
                    Panel de Administración
                </h1>
                <p class="page-header-subtitle">
                    <i class="fas fa-calendar-alt"></i>
                    Resumen general del sistema — @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                </p>
            </div>
            <div class="page-header-actions">
                <button type="button" class="btn btn-outline" onclick="window.location.reload();" title="Actualizar datos">
                    <i class="fas fa-sync-alt"></i>
                    <span>Actualizar</span>
                </button>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-toast alert-toast-error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- ============ RESUMEN RÁPIDO (Stats Row) ============ -->
    <div class="dashboard-summary">
        <div class="summary-card summary-card-primary">
            <div class="summary-icon">
                <i class="fas fa-building"></i>
            </div>
            <div class="summary-content">
                <span class="summary-value">@Model.TotalProperties</span>
                <span class="summary-label">Total Propiedades</span>
            </div>
        </div>
        <div class="summary-card summary-card-success">
            <div class="summary-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="summary-content">
                <span class="summary-value">@Model.AvailableProperties</span>
                <span class="summary-label">Disponibles</span>
            </div>
        </div>
        <div class="summary-card summary-card-gold">
            <div class="summary-icon">
                <i class="fas fa-handshake"></i>
            </div>
            <div class="summary-content">
                <span class="summary-value">@Model.SoldProperties</span>
                <span class="summary-label">Vendidas</span>
            </div>
        </div>
        <div class="summary-card summary-card-info">
            <div class="summary-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="summary-content">
                <span class="summary-value">@(Model.TotalAdmins + Model.TotalAgents + Model.TotalClients + Model.TotalDevelopers)</span>
                <span class="summary-label">Usuarios Totales</span>
            </div>
        </div>
    </div>

    <!-- ============ SECCIÓN USUARIOS (Grid 4 columnas) ============ -->
    <div class="dashboard-section">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h3 class="dashboard-card-title">
                    <i class="fas fa-users"></i>
                    Usuarios del Sistema
                </h3>
            </div>
            <div class="dashboard-card-body">
                <div class="users-grid">
                    <!-- Administradores -->
                    <div class="user-card">
                        <div class="user-card-icon user-card-icon-gold">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <div class="user-card-value">@Model.TotalAdmins</div>
                        <div class="user-card-label">Administradores</div>
                        <div class="user-card-badges">
                            @if (Model.ActiveAdmins > 0)
                            {
                                <span class="badge badge-success"><i class="fas fa-circle"></i> @Model.ActiveAdmins</span>
                            }
                            @if (Model.InactiveAdmins > 0)
                            {
                                <span class="badge badge-muted">@Model.InactiveAdmins</span>
                            }
                        </div>
                    </div>
                    <!-- Agentes -->
                    <div class="user-card">
                        <div class="user-card-icon user-card-icon-purple">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div class="user-card-value">@Model.TotalAgents</div>
                        <div class="user-card-label">Agentes</div>
                        <div class="user-card-badges">
                            @if (Model.ActiveAgents > 0)
                            {
                                <span class="badge badge-success"><i class="fas fa-circle"></i> @Model.ActiveAgents</span>
                            }
                            @if (Model.InactiveAgents > 0)
                            {
                                <span class="badge badge-muted">@Model.InactiveAgents</span>
                            }
                        </div>
                    </div>
                    <!-- Clientes -->
                    <div class="user-card">
                        <div class="user-card-icon user-card-icon-blue">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="user-card-value">@Model.TotalClients</div>
                        <div class="user-card-label">Clientes</div>
                        <div class="user-card-badges">
                            @if (Model.ActiveClients > 0)
                            {
                                <span class="badge badge-success"><i class="fas fa-circle"></i> @Model.ActiveClients</span>
                            }
                            @if (Model.InactiveClients > 0)
                            {
                                <span class="badge badge-muted">@Model.InactiveClients</span>
                            }
                        </div>
                    </div>
                    <!-- Desarrolladores -->
                    <div class="user-card">
                        <div class="user-card-icon user-card-icon-emerald">
                            <i class="fas fa-code"></i>
                        </div>
                        <div class="user-card-value">@Model.TotalDevelopers</div>
                        <div class="user-card-label">Desarrolladores</div>
                        <div class="user-card-badges">
                            @if (Model.ActiveDevelopers > 0)
                            {
                                <span class="badge badge-success"><i class="fas fa-circle"></i> @Model.ActiveDevelopers</span>
                            }
                            @if (Model.InactiveDevelopers > 0)
                            {
                                <span class="badge badge-muted">@Model.InactiveDevelopers</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ SECCIÓN CATÁLOGOS (Grid 3 columnas) ============ -->
    <div class="dashboard-section">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <h3 class="dashboard-card-title">
                    <i class="fas fa-cogs"></i>
                    Mantenimiento de Catálogos
                </h3>
            </div>
            <div class="dashboard-card-body">
                <div class="catalog-grid">
                    <!-- Tipos de Venta -->
                    <div class="catalog-item">
                        <div class="catalog-icon catalog-icon-gold">
                            <i class="fas fa-tags"></i>
                        </div>
                        <div class="catalog-content">
                            <span class="catalog-value">@Model.TotalSaleTypes</span>
                            <span class="catalog-label">Tipos de Venta</span>
                            <div class="catalog-status">
                                @if (Model.ActiveSaleTypes > 0)
                                {
                                    <span class="status-item status-success">
                                        <i class="fas fa-circle"></i> @Model.ActiveSaleTypes activos
                                    </span>
                                }
                                @if (Model.InactiveSaleTypes > 0)
                                {
                                    <span class="status-item status-muted">
                                        <i class="fas fa-circle"></i> @Model.InactiveSaleTypes inactivos
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- Tipos de Propiedad -->
                    <div class="catalog-item">
                        <div class="catalog-icon catalog-icon-dark">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <div class="catalog-content">
                            <span class="catalog-value">@Model.TotalPropertyTypes</span>
                            <span class="catalog-label">Tipos de Propiedad</span>
                            <div class="catalog-status">
                                @if (Model.ActivePropertyTypes > 0)
                                {
                                    <span class="status-item status-success">
                                        <i class="fas fa-circle"></i> @Model.ActivePropertyTypes activos
                                    </span>
                                }
                                @if (Model.InactivePropertyTypes > 0)
                                {
                                    <span class="status-item status-muted">
                                        <i class="fas fa-circle"></i> @Model.InactivePropertyTypes inactivos
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- Mejoras -->
                    <div class="catalog-item">
                        <div class="catalog-icon catalog-icon-emerald">
                            <i class="fas fa-magic"></i>
                        </div>
                        <div class="catalog-content">
                            <span class="catalog-value">@Model.TotalImprovements</span>
                            <span class="catalog-label">Mejoras</span>
                            <div class="catalog-status">
                                @if (Model.ActiveImprovements > 0)
                                {
                                    <span class="status-item status-success">
                                        <i class="fas fa-circle"></i> @Model.ActiveImprovements activos
                                    </span>
                                }
                                @if (Model.InactiveImprovements > 0)
                                {
                                    <span class="status-item status-muted">
                                        <i class="fas fa-circle"></i> @Model.InactiveImprovements inactivos
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        setTimeout(() => { location.reload(); }, 300000);
    </script>
}
