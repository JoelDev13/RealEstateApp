@model RealEstateApp.WebApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Panel de administración";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header-title">Panel de Administración</h1>
        <p class="page-header-subtitle">Resumen general del sistema</p>
    </div>
</div>

<!-- Stats Grid - Primera fila (Catálogos) -->
<div class="stats-grid">
    <!-- Tipos de Venta -->
    <div class="stat-card">
        <div class="stat-icon stat-icon-gold">
            <i class="fas fa-tags"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Tipos de Venta</div>
            <div class="stat-value">@Model.TotalSaleTypes</div>
            <div class="stat-detail">
                <span class="stat-detail-item positive">
                    <i class="fas fa-check-circle"></i>
                    @Model.ActiveSaleTypes activos
                </span>
                <span class="stat-detail-item negative">
                    <i class="fas fa-times-circle"></i>
                    @Model.InactiveSaleTypes inactivos
                </span>
            </div>
        </div>
    </div>

    <!-- Tipos de Propiedad -->
    <div class="stat-card">
        <div class="stat-icon stat-icon-emerald">
            <i class="fas fa-layer-group"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Tipos de Propiedad</div>
            <div class="stat-value">@Model.TotalPropertyTypes</div>
            <div class="stat-detail">
                <span class="stat-detail-item positive">
                    <i class="fas fa-check-circle"></i>
                    @Model.ActivePropertyTypes activos
                </span>
                <span class="stat-detail-item negative">
                    <i class="fas fa-times-circle"></i>
                    @Model.InactivePropertyTypes inactivos
                </span>
            </div>
        </div>
    </div>

    <!-- Mejoras -->
    <div class="stat-card">
        <div class="stat-icon stat-icon-blue">
            <i class="fas fa-magic"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Mejoras</div>
            <div class="stat-value">@Model.TotalImprovements</div>
            <div class="stat-detail">
                <span class="stat-detail-item positive">
                    <i class="fas fa-check-circle"></i>
                    @Model.ActiveImprovements activos
                </span>
                <span class="stat-detail-item negative">
                    <i class="fas fa-times-circle"></i>
                    @Model.InactiveImprovements inactivos
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Stats Grid - Segunda fila (Propiedades y Agentes) -->
<div class="stats-grid" style="grid-template-columns: repeat(2, 1fr);">
    <!-- Propiedades -->
    <div class="stat-card">
        <div class="stat-icon stat-icon-purple">
            <i class="fas fa-building"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Propiedades</div>
            <div class="stat-value">@Model.TotalProperties</div>
            <p class="text-xs text-slate-500 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Indicador preparado para el módulo de propiedades
            </p>
        </div>
    </div>

    <!-- Agentes -->
    <div class="stat-card">
        <div class="stat-icon" style="background: rgba(236, 72, 153, 0.15); color: #ec4899;">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="stat-content">
            <div class="stat-label">Agentes</div>
            <div class="stat-value">@Model.TotalAgents</div>
            <p class="text-xs text-slate-500 mt-2">
                <i class="fas fa-info-circle mr-1"></i>
                Indicador preparado para el módulo de agentes
            </p>
        </div>
    </div>
</div>

<!-- Accesos Rápidos -->
<div class="quick-actions-section">
    <h2 class="text-lg font-bold text-slate-800 mb-4">
        <i class="fas fa-bolt text-amber-500 mr-2"></i>
        Accesos Rápidos
    </h2>

    <div class="quick-actions-grid">
        <a asp-controller="AdminSaleTypes" asp-action="Index" class="quick-action-card">
            <div class="quick-action-icon" style="background: rgba(212, 175, 55, 0.15); color: #d4af37;">
                <i class="fas fa-tags"></i>
            </div>
            <div class="quick-action-content">
                <span class="quick-action-title">Tipos de Venta</span>
                <span class="quick-action-desc">Gestionar catálogo</span>
            </div>
            <i class="fas fa-chevron-right quick-action-arrow"></i>
        </a>

        <a asp-controller="AdminPropertyTypes" asp-action="Index" class="quick-action-card">
            <div class="quick-action-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="quick-action-content">
                <span class="quick-action-title">Tipos de Propiedad</span>
                <span class="quick-action-desc">Gestionar catálogo</span>
            </div>
            <i class="fas fa-chevron-right quick-action-arrow"></i>
        </a>

        <a asp-controller="AdminImprovements" asp-action="Index" class="quick-action-card">
            <div class="quick-action-icon" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
                <i class="fas fa-magic"></i>
            </div>
            <div class="quick-action-content">
                <span class="quick-action-title">Mejoras</span>
                <span class="quick-action-desc">Gestionar catálogo</span>
            </div>
            <i class="fas fa-chevron-right quick-action-arrow"></i>
        </a>

        <a asp-controller="AdminUsers" asp-action="Index" class="quick-action-card">
            <div class="quick-action-icon" style="background: rgba(100, 116, 139, 0.15); color: #64748b;">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="quick-action-content">
                <span class="quick-action-title">Administradores</span>
                <span class="quick-action-desc">Gestionar usuarios</span>
            </div>
            <i class="fas fa-chevron-right quick-action-arrow"></i>
        </a>
    </div>
</div>

<style>
    /* Quick Actions Section */
    .quick-actions-section {
        margin-top: 2rem;
        padding: 1.5rem;
        background: var(--color-surface-elevated, #ffffff);
        border-radius: var(--radius-lg, 16px);
        border: 1px solid var(--color-border, rgba(148, 163, 184, 0.2));
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }

    .quick-action-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: var(--color-surface, #f8fafc);
        border: 1px solid var(--color-border, rgba(148, 163, 184, 0.2));
        border-radius: var(--radius-md, 10px);
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .quick-action-card:hover {
            background: var(--color-surface-elevated, #ffffff);
            border-color: var(--color-accent-gold, #d4af37);
            box-shadow: 0 4px 12px rgba(212, 175, 55, 0.15);
            transform: translateY(-2px);
        }

    .quick-action-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md, 10px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.125rem;
        flex-shrink: 0;
    }

    .quick-action-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .quick-action-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-text-primary, #0f172a);
    }

    .quick-action-desc {
        font-size: 0.75rem;
        color: var(--color-text-secondary, #64748b);
    }

    .quick-action-arrow {
        color: var(--color-text-muted, #94a3b8);
        font-size: 0.75rem;
        transition: transform 0.2s ease;
    }

    .quick-action-card:hover .quick-action-arrow {
        transform: translateX(4px);
        color: var(--color-accent-gold, #d4af37);
    }

    /* Responsive */
    @@media (max-width: 640px) {
        .quick-actions-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
