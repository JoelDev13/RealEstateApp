@model List<RealEstateApp.Application.Dtos.Offers.OfferDto>
@{
    ViewData["Title"] = "Ofertas del Cliente";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="flex">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg min-h-screen">
            <div class="p-6 bg-gradient-to-r from-blue-600 to-indigo-600">
                <h3 class="text-white font-bold text-lg">Panel del Agente</h3>
            </div>
            <nav class="mt-6">
                <a href="@Url.Action("Dashboard", "Agent")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-home w-5 mr-3"></i> Home del agente
                </a>
                <a href="@Url.Action("Profile", "Agent")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-user w-5 mr-3"></i> Mi perfil
                </a>
                <a href="@Url.Action("Properties", "Agent")" class="flex items-center px-6 py-3 bg-blue-50 text-blue-600 border-r-4 border-blue-600">
                    <i class="fas fa-building w-5 mr-3"></i> Mantenimiento de propiedades
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 mr-3"></i> Cerrar sesión
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="flex items-center mb-2">
                            <a href="@Url.Action("PropertyOffers", new { propertyId = ViewBag.Property?.Id })" 
                               class="text-blue-600 hover:text-blue-800 mr-2">
                                <i class="fas fa-arrow-left mr-1"></i> Volver
                            </a>
                            <h1 class="text-3xl font-bold text-gray-800">Ofertas de Cliente</h1>
                        </div>
                        <p class="text-gray-600">
                            Propiedad: <span class="font-semibold">@ViewBag.Property?.Code</span> - 
                            @ViewBag.Property?.PropertyType en @ViewBag.Property?.Location
                        </p>
                        <p class="text-sm text-gray-500 mt-1">
                            Cliente ID: <span class="font-mono">@ViewBag.ClientId</span>
                        </p>
                    </div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-lg">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-500 mr-3"></i>
                        <p class="text-green-700">@TempData["Success"]</p>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-triangle text-red-500 mr-3"></i>
                        <p class="text-red-700">@TempData["Error"]</p>
                    </div>
                </div>
            }

            <!-- Listado de Ofertas del Cliente -->
            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                    <h2 class="text-2xl font-bold text-white">Historial de Ofertas</h2>
                </div>
                
                <div class="p-8">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-12">
                            <i class="fas fa-hand-holding-usd text-6xl text-gray-300 mb-4"></i>
                            <h3 class="text-xl font-semibold text-gray-600 mb-2">Este cliente no tiene ofertas</h3>
                            <p class="text-gray-500">Cuando haga ofertas, aparecerán aquí</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-6">
                            @foreach (var offer in Model.OrderByDescending(o => o.OfferDate))
                            {
                                <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1">
                                            <div class="flex items-center mb-3">
                                                <span class="text-3xl font-bold text-blue-600 mr-4">
                                                    @offer.Amount.ToString("C0", new System.Globalization.CultureInfo("es-DO"))
                                                </span>
                                                <span class="px-4 py-2 rounded-full text-sm font-medium
                                                    @(offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Pendiente ? "bg-yellow-100 text-yellow-800" :
                                                      offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada ? "bg-green-100 text-green-800" :
                                                      "bg-red-100 text-red-800")">
                                                    @if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Pendiente)
                                                    {
                                                        <i class="fas fa-clock mr-1"></i>
                                                    }
                                                    else if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada)
                                                    {
                                                        <i class="fas fa-check-circle mr-1"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-times-circle mr-1"></i>
                                                    }
                                                    @offer.StatusText
                                                </span>
                                            </div>
                                            
                                            <div class="text-sm text-gray-600 mb-4">
                                                <i class="far fa-calendar mr-2"></i>
                                                Fecha: @offer.OfferDate.ToString("dd/MM/yyyy HH:mm")
                                            </div>

                                            @if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Pendiente)
                                            {
                                                <div class="flex space-x-3">
                                                    <form asp-action="Accept" method="post" class="inline">
                                                        <input type="hidden" name="offerId" value="@offer.Id" />
                                                        <button type="submit" 
                                                                class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors flex items-center"
                                                                onclick="return confirm('¿Estás seguro de aceptar esta oferta? Esto marcará la propiedad como vendida y rechazará todas las demás ofertas.')">
                                                            <i class="fas fa-check mr-2"></i> Aceptar
                                                        </button>
                                                    </form>
                                                    
                                                    <form asp-action="Reject" method="post" class="inline">
                                                        <input type="hidden" name="offerId" value="@offer.Id" />
                                                        <button type="submit" 
                                                                class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors flex items-center"
                                                                onclick="return confirm('¿Estás seguro de rechazar esta oferta?')">
                                                            <i class="fas fa-times mr-2"></i> Rechazar
                                                        </button>
                                                    </form>
                                                </div>
                                                
                                                <div class="mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                                                    <p class="text-sm text-yellow-800">
                                                        <i class="fas fa-info-circle mr-1"></i>
                                                        <strong>Importante:</strong> Al aceptar esta oferta, la propiedad será marcada como vendida y todas las demás ofertas pendientes serán rechazadas automáticamente.
                                                    </p>
                                                </div>
                                            }
                                            else if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada)
                                            {
                                                <div class="p-3 bg-green-50 border border-green-200 rounded-lg">
                                                    <p class="text-sm text-green-800">
                                                        <i class="fas fa-check-circle mr-1"></i>
                                                        <strong>Oferta aceptada:</strong> La propiedad ha sido vendida y todas las demás ofertas fueron rechazadas automáticamente.
                                                    </p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-3 bg-gray-50 border border-gray-200 rounded-lg">
                                                    <p class="text-sm text-gray-600">
                                                        <i class="fas fa-times-circle mr-1"></i>
                                                        <strong>Oferta rechazada:</strong> Esta oferta fue rechazada. El cliente puede crear una nueva oferta si lo desea.
                                                    </p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
