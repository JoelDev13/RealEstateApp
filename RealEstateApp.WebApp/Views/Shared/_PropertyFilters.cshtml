@model RealEstateApp.Application.Dtos.Property.PropertyFiltersDto

<div class="filters-row">
    <div class="filter-group">
        <label class="filter-label">Código</label>
        <input type="text"
               name="Code"
               value="@Model.Code"
               placeholder="ABC123"
               class="filter-input" />
    </div>

    <div class="filter-group">
        <label class="filter-label">Tipo</label>
        <select name="PropertyTypeId" class="filter-select">
            <option value="">Todos</option>
            @if (ViewBag.PropertyTypes != null)
            {
                foreach (var type in ViewBag.PropertyTypes)
                {
                    <option value="@type.Id" selected="@(Model.PropertyTypeId == type.Id)">
                        @type.Name
                    </option>
                }
            }
        </select>
    </div>

    <div class="filter-group filter-small">
        <label class="filter-label">Hab.</label>
        <input type="number"
               name="Bedrooms"
               value="@Model.Bedrooms"
               placeholder="0"
               min="0"
               class="filter-input" />
    </div>

    <div class="filter-group filter-small">
        <label class="filter-label">Baños</label>
        <input type="number"
               name="Bathrooms"
               value="@Model.Bathrooms"
               placeholder="0"
               min="0"
               class="filter-input" />
    </div>

    <div class="filter-group filter-price-range">
        <label class="filter-label">Rango de Precio</label>
        <div class="price-range-container">
            <div class="price-range-display">
                <span class="price-value">
                    RD$
                    <span id="minPriceDisplay">
                        @(Model.MinPrice?.ToString("N0") ?? "10,000")
                    </span>
                </span>
                <span class="price-separator">-</span>
                <span class="price-value">
                    RD$
                    <span id="maxPriceDisplay">
                        @(Model.MaxPrice?.ToString("N0") ?? "10,000,000")
                    </span>+
                </span>
            </div>
            <div class="slider-container">
                <input type="range"
                       id="minPriceSlider"
                       name="MinPrice"
                       min="10000"
                       max="10000000"
                       step="10000"
                       value="@(Model.MinPrice ?? 10000)"
                       class="price-slider" />
                <input type="range"
                       id="maxPriceSlider"
                       name="MaxPrice"
                       min="10000"
                       max="10000000"
                       step="10000"
                       value="@(Model.MaxPrice ?? 10000000)"
                       class="price-slider" />
                <div class="slider-track"></div>
                <div class="slider-range" id="sliderRange"></div>
            </div>
        </div>
    </div>

    <div class="filter-actions">
        <button type="submit" class="btn-filter-primary">
            <i class="fas fa-search"></i> Buscar
        </button>
        <button type="button"
                class="btn-filter-clear"
                onclick="clearFiltersPartial()"
                title="Limpiar filtros">
            <i class="fas fa-times"></i>
        </button>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const minSlider = document.getElementById('minPriceSlider');
        const maxSlider = document.getElementById('maxPriceSlider');
        const minDisplay = document.getElementById('minPriceDisplay');
        const maxDisplay = document.getElementById('maxPriceDisplay');
        const sliderRange = document.getElementById('sliderRange');

        if (!minSlider || !maxSlider) return;

        const MIN_VALUE = 10000;
        const MAX_VALUE = 10000000;
        const STEP = 10000;

        function formatPrice(value) {
            return parseInt(value).toLocaleString('es-DO');
        }

        function updateSliderRange() {
            const min = parseInt(minSlider.value);
            const max = parseInt(maxSlider.value);
            const minPercent = ((min - MIN_VALUE) / (MAX_VALUE - MIN_VALUE)) * 100;
            const maxPercent = ((max - MIN_VALUE) / (MAX_VALUE - MIN_VALUE)) * 100;

            const adjustedLeft = 10 + ((minPercent / 100) * (sliderRange.parentElement.offsetWidth - 20));
            const adjustedWidth = ((maxPercent - minPercent) / 100) * (sliderRange.parentElement.offsetWidth - 20);

            sliderRange.style.left = adjustedLeft + 'px';
            sliderRange.style.width = adjustedWidth + 'px';
        }

        function updatePrices() {
            let minVal = parseInt(minSlider.value);
            let maxVal = parseInt(maxSlider.value);

            if (minVal > maxVal - STEP) {
                minVal = maxVal - STEP;
                minSlider.value = minVal;
            }

            minDisplay.textContent = formatPrice(minVal);
            maxDisplay.textContent = formatPrice(maxVal);
            updateSliderRange();
        }

        minSlider.addEventListener('input', function () {
            let minVal = parseInt(this.value);
            let maxVal = parseInt(maxSlider.value);

            if (minVal > maxVal - STEP) {
                this.value = maxVal - STEP;
            }
            updatePrices();
        });

        maxSlider.addEventListener('input', function () {
            let minVal = parseInt(minSlider.value);
            let maxVal = parseInt(this.value);

            if (maxVal < minVal + STEP) {
                this.value = minVal + STEP;
            }
            updatePrices();
        });

        updatePrices();
    });

    function clearFiltersPartial() {
        const form = document.querySelector('.filters-form');
        if (!form) return;

        const agentIdInput = form.querySelector('input[name="agentId"]');
        const agentId = agentIdInput ? agentIdInput.value : null;

        const formAction = form.action || form.getAttribute('action');

        if (agentId) {
            window.location.href = `/AgentList/Properties?agentId=${agentId}`;
        } else if (formAction && formAction.includes('MyProperties')) {
            window.location.href = '/ClientProperty/MyProperties';
        } else {
            window.location.href = '/Home/Index';
        }
    }
</script>
