<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="RealEstateApp - Tu plataforma de propiedades inmobiliarias" />
    <title>@ViewData["Title"] - RealEstateApp</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="antialiased">
    <div class="app-layout">
        <!-- Sidebar Overlay (Mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <!-- Brand Header -->
            <div class="sidebar-header">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="sidebar-brand">
                    <div class="sidebar-brand-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="sidebar-brand-text">
                        <span class="sidebar-brand-name">RealEstate</span>
                        <span class="sidebar-brand-tagline">Propiedades Premium</span>
                    </div>
                </a>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                @if (!User.Identity?.IsAuthenticated ?? true)
                {
                    <!-- Menu para visitantes no autenticados -->
                    <div class="nav-section">
                        <div class="nav-section-title">Explorar</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Home" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-home"></i>
                                    </span>
                                    <span class="nav-link-text">Inicio</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Agents" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Agents" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-user-tie"></i>
                                    </span>
                                    <span class="nav-link-text">Agentes</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Cuenta</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Account" asp-action="Register"
                                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Register" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-user-plus"></i>
                                    </span>
                                    <span class="nav-link-text">Únete a la App</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Account" asp-action="Login"
                                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-sign-in-alt"></i>
                                    </span>
                                    <span class="nav-link-text">Iniciar Sesión</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <!-- Menu para Clientes -->
                    <div class="nav-section">
                        <div class="nav-section-title">Principal</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="ClientHome" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClientHome" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-home"></i>
                                    </span>
                                    <span class="nav-link-text">Inicio</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Agents" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Agents" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-user-tie"></i>
                                    </span>
                                    <span class="nav-link-text">Agentes</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Mis Propiedades</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Favorites" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Favorites" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-heart"></i>
                                    </span>
                                    <span class="nav-link-text">Mis Favoritas</span>
                                    <span class="nav-badge">@(ViewData["FavoritesCount"] ?? "0")</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else if (User.IsInRole("Agente"))
                {
                    <!-- Menu para Agentes -->
                    <div class="nav-section">
                        <div class="nav-section-title">Dashboard</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="AgentHome" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AgentHome" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-chart-line"></i>
                                    </span>
                                    <span class="nav-link-text">Mi Dashboard</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Gestión</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Properties" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Properties" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-building"></i>
                                    </span>
                                    <span class="nav-link-text">Mis Propiedades</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Properties" asp-action="Create"
                                   class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-plus-circle"></i>
                                    </span>
                                    <span class="nav-link-text">Nueva Propiedad</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Mi Cuenta</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Profile" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-user-circle"></i>
                                    </span>
                                    <span class="nav-link-text">Mi Perfil</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else if (User.IsInRole("Administrador"))
                {
                    <!-- Menu para Administradores -->
                    <div class="nav-section">
                        <div class="nav-section-title">Dashboard</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="AdminHome" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminHome" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-tachometer-alt"></i>
                                    </span>
                                    <span class="nav-link-text">Panel Principal</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Usuarios</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="AgentManagement" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AgentManagement" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-user-tie"></i>
                                    </span>
                                    <span class="nav-link-text">Agentes</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="AdminManagement" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminManagement" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-user-shield"></i>
                                    </span>
                                    <span class="nav-link-text">Administradores</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="DeveloperManagement" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DeveloperManagement" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-code"></i>
                                    </span>
                                    <span class="nav-link-text">Desarrolladores</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Catálogos</div>
                        <ul class="nav-list stagger-children">
                            <li class="nav-item">
                                <a asp-area="" asp-controller="PropertyTypes" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PropertyTypes" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-layer-group"></i>
                                    </span>
                                    <span class="nav-link-text">Tipos de Propiedad</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="SaleTypes" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SaleTypes" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-tags"></i>
                                    </span>
                                    <span class="nav-link-text">Tipos de Venta</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Improvements" asp-action="Index"
                                   class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Improvements" ? "active" : "")">
                                    <span class="nav-link-icon">
                                        <i class="fas fa-magic"></i>
                                    </span>
                                    <span class="nav-link-text">Mejoras</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </nav>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-card">
                        <div class="user-avatar">
                            @{
                                var initials = User.Identity.Name?.Length > 0
                                ? User.Identity.Name.Substring(0, 1).ToUpper()
                                : "U";
                            }
                            @initials
                        </div>
                        <div class="user-info">
                            <div class="user-name">@User.Identity.Name</div>
                            <div class="user-role">
                                @if (User.IsInRole("Administrador"))
                                {
                                    <text>Administrador</text>
                                }
                                else if (User.IsInRole("Agente"))
                                {

                                    <text>Agente</text>
                                }
                                else if (User.IsInRole("Cliente"))
                                {

                                    <text>Cliente</text>
                                }
                            </div>
                        </div>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            <button type="submit" class="logout-btn" title="Cerrar sesión">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </div>
                }
                <div class="sidebar-copyright">
                    © @DateTime.UtcNow.Year RealEstateApp. Todos los derechos reservados.
                </div>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="main-wrapper">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <button type="button" class="mobile-menu-toggle" onclick="toggleSidebar()">
                        <i class="fas fa-bars"></i>
                    </button>

                    @if (ViewData["Title"] != null)
                    {
                        <h1 class="page-title">@ViewData["Title"]</h1>
                    }
                </div>

                <div class="header-right">
                    <!-- Search Bar -->
                    <div class="search-bar">
                        <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text"
                               class="search-input"
                               placeholder="Buscar por código de propiedad..."
                               id="globalSearch" />
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Notifications -->
                        <button type="button" class="header-action" title="Notificaciones">
                            <i class="fas fa-bell"></i>
                            <span class="notification-dot"></span>
                        </button>
                    }
                </div>
            </header>

            <!-- Flash Messages / Alerts -->
            @if (TempData["Success"] != null)
            {
                <div class="mx-8 mt-4">
                    <div class="flex items-center gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800">
                        <i class="fas fa-check-circle text-emerald-500"></i>
                        <span>@TempData["Success"]</span>
                        <button type="button" class="ml-auto text-emerald-500 hover:text-emerald-700" onclick="this.parentElement.remove()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mx-8 mt-4">
                    <div class="flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800">
                        <i class="fas fa-exclamation-circle text-red-500"></i>
                        <span>@TempData["Error"]</span>
                        <button type="button" class="ml-auto text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            }

            <!-- Main Content Area -->
            <main class="main-content" role="main">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="main-footer">
                <div>
                    © @DateTime.UtcNow.Year RealEstateApp - Propiedades Inmobiliarias
                </div>
                <div class="footer-links">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    <a href="#">Términos</a>
                    <a href="#">Contacto</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Toggle Sidebar for Mobile
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('open');
            overlay.classList.toggle('open');
        }

        // Close sidebar when pressing Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                sidebar.classList.remove('open');
                overlay.classList.remove('open');
            }
        });

        // Global Search Handler
        document.getElementById('globalSearch')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const code = this.value.trim();
                if (code) {
                    window.location.href = '/Home/Index?code=' + encodeURIComponent(code);
                }
            }
        });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
