<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp.WebApp</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="min-h-screen bg-slate-100 flex">
        <aside class="flex flex-col w-64 bg-slate-900 text-white">
            <div class="px-6 py-6 border-b border-slate-800">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-lg font-semibold tracking-wide text-white hover:text-slate-300">RealEstateApp</a>
            </div>
            <nav class="flex-1 px-6 py-4 space-y-2 text-sm font-medium">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition text-white hover:text-slate-300">
                    <span>Home</span>
                </a>
                <a asp-area="" asp-controller="Agents" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition text-white hover:text-slate-300">
                    <span>Agentes</span>
                </a>
                <a asp-area="" asp-controller="Account" asp-action="Register" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition text-white hover:text-slate-300">
                    <span>Únete a la app</span>
                </a>
                <a asp-area="" asp-controller="Account" asp-action="Login" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition text-white hover:text-slate-300">
                    <span>Iniciar sesión</span>
                </a>
            </nav>
            <div class="px-6 py-4 border-t border-slate-800 text-xs text-slate-400">
                &copy; @DateTime.UtcNow.Year RealEstateApp
            </div>
        </aside>

        <div class="flex-1 flex flex-col">
            <main role="main" class="flex-1 px-4 md:px-8 py-6">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mb-6 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm">
                        Bienvenido, @User.Identity.Name
                    </div>
                }
                @RenderBody()
            </main>
            <footer class="px-4 md:px-8 py-4 border-t border-slate-200 text-sm text-slate-500">
                &copy; 2025 - RealEstateApp.WebApp - <a class="underline" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
