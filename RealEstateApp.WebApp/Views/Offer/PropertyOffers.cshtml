@model List<RealEstateApp.Application.Dtos.Offers.OfferDto>
@{
    ViewData["Title"] = "Mis Ofertas";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="flex">
        <!-- Sidebar -->
        <div class="w-64 bg-white shadow-lg min-h-screen">
            <div class="p-6 bg-gradient-to-r from-blue-600 to-indigo-600">
                <h3 class="text-white font-bold text-lg">Panel del Cliente</h3>
            </div>
            <nav class="mt-6">
                <a href="@Url.Action("Index", "Home")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-home w-5 mr-3"></i> Home
                </a>
                <a href="@Url.Action("Profile", "Account")" class="flex items-center px-6 py-3 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                    <i class="fas fa-user w-5 mr-3"></i> Mi perfil
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-6 py-3 text-red-600 hover:bg-red-50 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 mr-3"></i> Cerrar sesión
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8">
            <!-- Header -->
            <div class="mb-8">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 mb-2">Mis Ofertas</h1>
                        <p class="text-gray-600">
                            Propiedad: <span class="font-semibold">@ViewBag.Property?.Code</span> - 
                            @ViewBag.Property?.PropertyType en @ViewBag.Property?.Location
                        </p>
                    </div>
                    <a href="@Url.Action("Details", "Property", new { id = ViewBag.Property?.Id })" 
                       class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors flex items-center">
                        <i class="fas fa-arrow-left mr-2"></i> Volver a Propiedad
                    </a>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-lg">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle text-green-500 mr-3"></i>
                        <p class="text-green-700">@TempData["Success"]</p>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-triangle text-red-500 mr-3"></i>
                        <p class="text-red-700">@TempData["Error"]</p>
                    </div>
                </div>
            }

            <!-- Boton Nueva Oferta -->
            <div class="mb-8">
                <button id="btnNuevaOferta" 
                        class="px-6 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all transform hover:scale-105 flex items-center shadow-lg @(ViewBag.CanCreateOffer == false ? "opacity-50 cursor-not-allowed" : "")"
                        @(ViewBag.CanCreateOffer == false ? "disabled" : "onclick='abrirModalOferta()'")>
                    <i class="fas fa-hand-holding-usd mr-2"></i> Nueva Oferta
                </button>
                @if (ViewBag.CanCreateOffer == false)
                {
                    <p class="text-sm text-gray-500 mt-2">
                        <i class="fas fa-info-circle"></i> 
                        No puedes crear ofertas en este momento. La propiedad puede tener una oferta aceptada o ya tienes una oferta pendiente.
                    </p>
                }
            </div>

            <!-- Listado de Ofertas -->
            <div class="bg-white rounded-xl shadow-xl overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-6">
                    <h2 class="text-2xl font-bold text-white">Historial de Ofertas</h2>
                </div>
                
                <div class="p-8">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-12">
                            <i class="fas fa-hand-holding-usd text-6xl text-gray-300 mb-4"></i>
                            <h3 class="text-xl font-semibold text-gray-600 mb-2">No tienes ofertas aún</h3>
                            <p class="text-gray-500">Cuando hagas una oferta, aparecerá aquí</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var offer in Model.OrderByDescending(o => o.OfferDate))
                            {
                                <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                                    <div class="flex items-center justify-between">
                                        <div class="flex-1">
                                            <div class="flex items-center mb-2">
                                                <span class="text-2xl font-bold text-blue-600">
                                                    @offer.Amount.ToString("C0", new System.Globalization.CultureInfo("es-DO"))
                                                </span>
                                                <span class="ml-3 px-3 py-1 rounded-full text-sm font-medium
                                                    @(offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Pendiente ? "bg-yellow-100 text-yellow-800" :
                                                      offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada ? "bg-green-100 text-green-800" :
                                                      "bg-red-100 text-red-800")">
                                                    @offer.StatusText
                                                </span>
                                            </div>
                                            <div class="text-sm text-gray-600">
                                                <i class="far fa-calendar mr-2"></i>
                                                Fecha: @offer.OfferDate.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        </div>
                                        <div class="ml-4">
                                            @if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Pendiente)
                                            {
                                                <i class="fas fa-clock text-yellow-500 text-2xl"></i>
                                            }
                                            else if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada)
                                            {
                                                <i class="fas fa-check-circle text-green-500 text-2xl"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle text-red-500 text-2xl"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Oferta -->
<div id="modalOferta" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4 rounded-t-xl">
            <h3 class="text-xl font-bold text-white">Hacer una Oferta</h3>
        </div>
        
        <form asp-action="Create" method="post" class="p-6">
            <input type="hidden" name="PropertyId" value="@ViewBag.Property?.Id" />
            
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Monto a ofertar:</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500">$</span>
                    <input type="number" 
                           name="Amount" 
                           class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                           step="0.01" 
                           min="1" 
                           required 
                           placeholder="0.00">
                    <span class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500">DOP</span>
                </div>
            </div>
            
            <div class="flex justify-end space-x-3">
                <button type="button" onclick="cerrarModalOferta()" 
                        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                    Cancelar
                </button>
                <button type="submit" 
                        class="px-6 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-colors">
                    Enviar Oferta
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalOferta() {
            document.getElementById('modalOferta').classList.remove('hidden');
        }
        
        function cerrarModalOferta() {
            document.getElementById('modalOferta').classList.add('hidden');
        }
        
        // Cerrar modal al hacer clic fuera
        document.getElementById('modalOferta').addEventListener('click', function(e) {
            if (e.target === this) {
                cerrarModalOferta();
            }
        });
    </script>
}
