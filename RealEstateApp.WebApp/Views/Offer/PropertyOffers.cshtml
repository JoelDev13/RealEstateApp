@model List<RealEstateApp.Application.Dtos.Offers.OfferDto>

@{
    ViewData["Title"] = "Mis Ofertas";
}

<link rel="stylesheet" href="~/css/PropertyDetails/property-details-base.css" />
<link rel="stylesheet" href="~/css/client-offers.css" />

<div class="client-offers-page">
    <div class="offers-container">

        <!-- Back Button -->
        <div class="back-section">
            <a href="@Url.Action("Details", "PublicProperty", new { id = ViewBag.Property?.Id })" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                <span>Volver a la Propiedad</span>
            </a>
        </div>

        <!-- Page Header -->
        <div class="offers-header">
            <div class="header-left">
                <h1 class="page-title">Mis Ofertas</h1>
                <p class="property-info">
                    <span class="property-code">@ViewBag.Property?.Code</span>
                    <span class="separator">•</span>
                    <span>@ViewBag.Property?.PropertyType</span>
                    <span class="separator">•</span>
                    <span>@ViewBag.Property?.SaleType</span>

                </p>
            </div>
            <div class="header-right">
                @if (ViewBag.CanCreateOffer == true)
                {
                    <button type="button" onclick="abrirModalOferta()" class="btn-new-offer">
                        <i class="fas fa-plus-circle"></i>
                        <span>Nueva Oferta</span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn-new-offer disabled" disabled>
                        <i class="fas fa-ban"></i>
                        <span>No Disponible</span>
                    </button>
                }
            </div>
        </div>

        <!-- Alert Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        <!-- Info Box -->
        @if (ViewBag.CanCreateOffer == false)
        {
            <div class="info-banner">
                <div class="info-icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div class="info-content">
                    <h4>No puedes crear ofertas en este momento</h4>
                    <p>La propiedad puede tener una oferta aceptada o ya tienes una oferta pendiente.</p>
                </div>
            </div>
        }

        <!-- Offers List -->
        <div class="offers-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="fas fa-history"></i>
                    Historial de Ofertas
                </h2>
                @if (Model.Any())
                {
                    <span class="offers-count">@Model.Count @(Model.Count == 1 ? "oferta" : "ofertas")</span>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <h3 class="empty-title">No tienes ofertas aún</h3>
                    <p class="empty-text">Haz tu primera oferta para esta propiedad</p>
                    @if (ViewBag.CanCreateOffer == true)
                    {
                        <button type="button" onclick="abrirModalOferta()" class="btn-empty-action">
                            <i class="fas fa-plus-circle"></i>
                            Hacer una Oferta
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="offers-timeline">
                    @foreach (var offer in Model.OrderByDescending(o => o.OfferDate))
                    {
                        <div class="offer-card @offer.Status.ToString().ToLower()">
                            <div class="offer-marker">
                                @if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Pendiente)
                                {
                                    <i class="fas fa-clock"></i>
                                }
                                else if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada)
                                {
                                    <i class="fas fa-check-circle"></i>
                                }
                                else
                                {
                                    <i class="fas fa-times-circle"></i>
                                }
                            </div>
                            <div class="offer-content">
                                <div class="offer-header">
                                    <div class="offer-amount-section">
                                        <span class="offer-amount">RD$@offer.Amount.ToString("N0")</span>
                                        <span class="offer-date">
                                            <i class="fas fa-calendar-alt"></i>
                                            @offer.OfferDate.ToString("dd/MM/yyyy • HH:mm")
                                        </span>
                                    </div>
                                    <span class="offer-status @offer.Status.ToString().ToLower()">
                                        @offer.StatusText
                                    </span>
                                </div>
                                @if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Aceptada)
                                {
                                    <div class="offer-message success">
                                        <i class="fas fa-trophy"></i>
                                        <span>¡Felicidades! Tu oferta fue aceptada</span>
                                    </div>
                                }
                                else if (offer.Status == RealEstateApp.Domain.Enums.OfferStatus.Rechazada)
                                {
                                    <div class="offer-message rejected">
                                        <i class="fas fa-info-circle"></i>
                                        <span>Esta oferta fue rechazada por el agente</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="offer-message pending">
                                        <i class="fas fa-hourglass-half"></i>
                                        <span>Esperando respuesta del agente</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

<!-- Modal Nueva Oferta -->
<div id="modalOferta" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h3 class="modal-title">
                <i class="fas fa-hand-holding-usd"></i>
                Hacer una Oferta
            </h3>
            <button type="button" class="modal-close" onclick="cerrarModalOferta()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form asp-action="Create" asp-controller="Offer" method="post" class="modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PropertyId" value="@ViewBag.Property?.Id" />

            <div class="form-group">
                <label class="form-label">Monto a ofertar</label>
                <div class="input-wrapper">
                    <span class="input-prefix">RD$</span>
                    <input type="number"
                           name="Amount"
                           class="form-input"
                           step="0.01"
                           min="1"
                           required
                           placeholder="0.00"
                           autocomplete="off" />
                    <span class="input-suffix">DOP</span>
                </div>
                <p class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Ingresa el monto que deseas ofertar por esta propiedad
                </p>
            </div>

            <div class="property-summary">
                <div class="summary-item">
                    <span class="summary-label">Propiedad: </span>
                    <span class="summary-value">@ViewBag.Property?.Code</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Precio publicado:</span>
                    <span class="summary-value price">RD$@ViewBag.Property?.Price.ToString("N0")</span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="cerrarModalOferta()" class="btn-modal-cancel">
                    <i class="fas fa-times"></i>
                    Cancelar
                </button>
                <button type="submit" class="btn-modal-submit">
                    <i class="fas fa-paper-plane"></i>
                    Enviar Oferta
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalOferta() {
            document.getElementById('modalOferta').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function cerrarModalOferta() {
            document.getElementById('modalOferta').classList.remove('active');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                cerrarModalOferta();
            }
        });

        document.getElementById('modalOferta').addEventListener('click', function (e) {
            if (e.target === this) {
                cerrarModalOferta();
            }
        });

        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function (alert) {
                alert.style.transition = 'opacity 0.5s, transform 0.5s';
                alert.style.opacity = '0';
                alert.style.transform = 'translateY(-20px)';
                setTimeout(function () {
                    alert.remove();
                }, 500);
            });
        }, 5000);
    </script>
}
