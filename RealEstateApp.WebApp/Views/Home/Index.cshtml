@model IEnumerable<RealEstateApp.Application.Dtos.Property.PropertyDto>
@using RealEstateApp.Application.Dtos.Property

@{
    ViewData["Title"] = "Home";
    var filters = ViewBag.Filters as PropertyFiltersDto ?? new PropertyFiltersDto();
    var totalProperties = Model.Count();
}

@Html.AntiForgeryToken()

<link rel="stylesheet" href="~/css/home-properties.css" />

<div class="home-page">
    <div class="home-container">
        <div class="home-header">
            <div class="header-info">
                <h1 class="header-title">Propiedades Disponibles</h1>
                <p class="header-subtitle">
                    <span class="property-count">@totalProperties</span> propiedades encontradas
                </p>
            </div>
        </div>

        <div class="filters-section">
            <form asp-action="Index" asp-controller="Home" method="get" class="filters-form">
                @await Html.PartialAsync("_PropertyFilters", filters)
            </form>
        </div>

        @if (Model.Any())
        {
            <div class="properties-grid">
                @foreach (var property in Model)
                {
                    <article class="property-card">
                        <div class="card-image">
                            @if (ViewBag.IsAuthenticated == true)
                            {
                                <form asp-action="ToggleFavorite" asp-controller="ClientProperty" method="post" class="fav-form">
                                    <input type="hidden" name="propertyId" value="@property.Id" />
                                    <button type="submit" class="btn-favorite @(ViewBag.FavoritePropertyIds.Contains(property.Id) ? "is-favorite" : "")" title="Favorito">
                                        <i class="@(ViewBag.FavoritePropertyIds.Contains(property.Id) ? "fas" : "far") fa-heart"></i>
                                    </button>
                                </form>
                            }

                            <span class="badge-type">@(!string.IsNullOrWhiteSpace(property.PropertyType) ? property.PropertyType : "Propiedad")</span>
                            <span class="badge-sale">@(!string.IsNullOrWhiteSpace(property.SaleType) ? property.SaleType : "Venta")</span>

                            @if (!string.IsNullOrEmpty(property.MainImageUrl))
                            {
                                <img src="@property.MainImageUrl" alt="@property.Code" class="card-img" loading="lazy">
                            }
                            else
                            {
                                <div class="card-img-placeholder">
                                    <i class="fas fa-home"></i>
                                </div>
                            }
                        </div>

                        <div class="card-content">
                            <p class="card-code">Código: @property.Code</p>

                            <div class="card-price">
                                RD$@property.Price.ToString("N0") <span class="currency">DOP</span>
                            </div>

                            <div class="card-features">
                                <div class="feature">
                                    <i class="fas fa-bed"></i>
                                    <span>@property.Bedrooms Hab.</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-bath"></i>
                                    <span>@property.Bathrooms Baños</span>
                                </div>
                                <div class="feature">
                                    <i class="fas fa-ruler-combined"></i>
                                    <span>@property.Size m²</span>
                                </div>
                            </div>

                            <a href="@Url.Action("Details", "PublicProperty", new { id = property.Id })" class="btn-view-details">
                                Ver detalles <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="empty-title">No se encontraron propiedades</h3>
                <p class="empty-text">Intenta ajustar los filtros de búsqueda</p>
                <a href="@Url.Action("Index", "Home")" class="btn-empty-action">
                    <i class="fas fa-redo"></i> Limpiar filtros
                </a>
            </div>
        }
    </div>
</div>
