@model IEnumerable<RealEstateApp.Application.Dtos.Property.PropertyDto>
@{
    ViewData["Title"] = "Home";
}

@Html.AntiForgeryToken()

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <!-- Navigation Header -->
    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center">
                        <i class="fas fa-home text-blue-600 text-2xl mr-2"></i>
                        <span class="font-bold text-xl text-gray-800">RealEstate</span>
                    </div>
                </div>
                
                <div class="flex items-center space-x-8">
                    <a href="@Url.Action("Index", "Home")" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">Home</a>
                    <a href="@Url.Action("Index", "AgentList")" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">Agentes</a>
                    
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        <div class="flex items-center space-x-4">
                            <a href="@Url.Action("MyProperties", "ClientProperty")" class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">
                                <i class="fas fa-heart mr-1"></i> Mis Propiedades
                            </a>
                            <div class="relative">
                                <button class="flex items-center text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium">
                                    <i class="fas fa-user-circle mr-2"></i>
                                    @ViewBag.UserName
                                </button>
                            </div>
                            <a href="@Url.Action("Logout", "Account")" class="text-red-600 hover:text-red-800 px-3 py-2 rounded-md text-sm font-medium">
                                <i class="fas fa-sign-out-alt mr-1"></i> Cerrar sesión
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center space-x-4">
                            <a href="@Url.Action("Login", "Account")" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700">
                                Iniciar Sesión
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Search and Filters Section -->
        <div class="bg-white rounded-xl shadow-xl p-6 mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Buscar Propiedades</h2>
            
            <!-- Search and Filter Form -->
            <form asp-action="Index" asp-controller="Home" method="get" class="space-y-6">
                <!-- Search by Code -->
                <div class="flex items-center space-x-4">
                    <label class="text-sm font-medium text-gray-700">Buscar propiedad por código:</label>
                    <div class="flex items-center space-x-2">
                        <input type="text" 
                               name="searchCode" 
                               value="@ViewBag.SearchCode"
                               class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                               placeholder="Ej: #123456">
                        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
                            <i class="fas fa-search mr-2"></i> Buscar
                        </button>
                    </div>
                </div>

                <!-- Filters -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de propiedad:</label>
                        <select name="propertyType" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            <option value="">Todos</option>
                            @if (ViewBag.PropertyTypes != null)
                            {
                                @foreach (var type in ViewBag.PropertyTypes)
                                {
                                    @if (ViewBag.PropertyType == type.Name)
                                    {
                                        <option value="@type.Name" selected>@type.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@type.Name">@type.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Precio mínimo:</label>
                        <input type="number" 
                               name="minPrice" 
                               value="@ViewBag.MinPrice"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                               placeholder="0">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Precio máximo:</label>
                        <input type="number" 
                               name="maxPrice" 
                               value="@ViewBag.MaxPrice"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                               placeholder="999999999">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Habitaciones:</label>
                        <input type="number" 
                               name="bedrooms" 
                               value="@ViewBag.Bedrooms"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                               placeholder="0">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Baños:</label>
                        <input type="number" 
                               name="bathrooms" 
                               value="@ViewBag.Bathrooms"
                               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                               placeholder="0">
                    </div>
                </div>
                
                <div class="flex space-x-4">
                    <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">
                        <i class="fas fa-filter mr-2"></i> Aplicar Filtros
                    </button>
                    <a href="@Url.Action("Index", "Home")" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300">
                        <i class="fas fa-times mr-2"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>

        <!-- Properties Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var property in Model.OrderByDescending(p => p.CreatedAt))
            {
                <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                    <!-- Favorite Button (only for authenticated users) -->
                    @if (ViewBag.IsAuthenticated == true)
                    {
                        <div class="absolute top-4 right-4 z-10">
                            <form asp-action="ToggleFavorite" asp-controller="ClientProperty" method="post" class="inline">
                                <input type="hidden" name="propertyId" value="@property.Id" />
                                <button type="submit" 
                                        class="bg-white rounded-full p-2 shadow-lg hover:shadow-xl transition-all">
                                    <i class="fas fa-heart text-xl @(ViewBag.FavoritePropertyIds.Contains(property.Id) ? "text-red-500" : "text-gray-300")"></i>
                                </button>
                            </form>
                        </div>
                    }
                    
                    <!-- Property Image -->
                    <div class="relative h-48 bg-gradient-to-br from-blue-500 to-blue-600">
                        @if (!string.IsNullOrEmpty(property.MainImageUrl))
                        {
                            <img src="~/Images/Properties/@property.MainImageUrl" 
                                 alt="@property.Code" 
                                 class="w-full h-48 object-cover"
                                 onerror="this.outerHTML='<div class=\'w-full h-48 bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center\'><div class=\'text-white text-center\'><i class=\'fas fa-exclamation-triangle text-4xl mb-2 opacity-80\'></i><p class=\'text-sm font-medium\'>Error Imagen</p></div></div>'">
                        }
                        else
                        {
                            <div class="w-full h-48 flex items-center justify-center">
                                <div class="text-white text-center">
                                    <i class="fas fa-home text-4xl mb-2 opacity-80"></i>
                                    <p class="text-sm font-medium">Sin Imagen</p>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <!-- Property Info -->
                    <div class="p-6">
                        <div class="mb-4">
                            <h3 class="text-lg font-bold text-gray-800">@property.Code</h3>
                            <p class="text-sm text-gray-600">@property.PropertyType</p>
                            <p class="text-sm text-gray-600">@property.SaleType</p>
                        </div>
                        
                        <div class="mb-4">
                            <p class="text-2xl font-bold text-blue-600">
                                @property.Price.ToString("C0", new System.Globalization.CultureInfo("es-DO")) DOP
                            </p>
                        </div>
                        
                        <div class="mb-4 text-sm text-gray-600">
                            <div class="flex items-center mb-1">
                                <i class="fas fa-bed mr-2"></i> @property.Bedrooms Habitaciones
                            </div>
                            <div class="flex items-center mb-1">
                                <i class="fas fa-bath mr-2"></i> @property.Bathrooms Baños
                            </div>
                            <div class="flex items-center">
                                <i class="fas fa-ruler-combined mr-2"></i> @property.Size m²
                            </div>
                        </div>
                        
                        <div class="flex space-x-2">
                            <a href="@Url.Action("Details", "PublicProperty", new { id = property.Id })" 
                               class="flex-1 bg-blue-600 text-white text-center py-2 rounded-lg hover:bg-blue-700 transition-colors">
                                Ver Detalles
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-home text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No se encontraron propiedades</h3>
                <p class="text-gray-500">Intenta ajustar los filtros de búsqueda</p>
            </div>
        }
    </div>
</div>
